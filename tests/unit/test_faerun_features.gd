extends TestCase

var _book_content: BookContentFixture

func before_each() -> void:
	_book_content = BookContentFixture.new()

func after_each() -> void:
	_book_content.restore()

func test_adept_spells_follow_maximum_slots_and_use_class_casting() -> void:
	var ch := TestChars.custom("wizard", "human", 4, {"ability_score_improvement": ["abjuration_adept"]})
	var shield := ch.granted_spells.filter(func(s: Dictionary) -> bool: return str(s["id"]) == "shield")
	assert_false(shield.is_empty())
	if shield.is_empty():return
	assert_eq(str(shield[0]["class_id"]), "wizard")
	assert_eq(str(shield[0]["ability"]), "int")
	assert_true(ch.granted_spells.any(func(s: Dictionary) -> bool: return str(s["id"]) == "lesser_restoration"))
	assert_false(ch.granted_spells.any(func(s: Dictionary) -> bool: return str(s["id"]) == "banishment"))
	while ch.slots_left(2) > 0:
		ch.expend_slot(2)
	ch.refresh()
	assert_true(ch.granted_spells.any(func(s: Dictionary) -> bool: return str(s["id"]) == "lesser_restoration"), "spent slots do not unprepare spells")

func test_adept_pact_slots_unlock_lower_level_spells() -> void:
	var ch := TestChars.custom("warlock", "human", 9, {"4.ability_score_improvement": ["abjuration_adept"]})
	for id: String in ["shield", "lesser_restoration", "protection_from_energy", "banishment", "mass_cure_wounds"]:
		assert_true(ch.granted_spells.any(func(s: Dictionary) -> bool: return str(s["id"]) == id), id)

func test_vestige_domain_choice_prepares_warlock_spells_at_warlock_levels() -> void:
	var ch := TestChars.custom("warlock", "human", 7, {"warlock_subclass": ["vestige_patron"], "vestige_spells": ["life"]})
	assert_true(ch.granted_spells.any(func(s: Dictionary) -> bool: return str(s["id"]) == "aura_of_life" and str(s["class_id"]) == "warlock" and str(s["ability"]) == "cha"))
	assert_false(ch.granted_spells.any(func(s: Dictionary) -> bool: return str(s["id"]) == "greater_restoration"))

func test_conditional_resistance_updates_immediately_when_crossing_bloodied() -> void:
	var c := TestChars.dummy(100)
	var feat := Compendium.shared().feat_data("boon_of_desperate_resilience")
	var fx := Effect.new("Boon", &"feat", "boon_of_desperate_resilience")
	for m: Variant in ((feat["benefits"] as Array)[-1] as Dictionary)["modifiers"]:
		fx.modifiers.append(Modifier.make(m as Dictionary, "Desperate Resilience"))
	c.add_effect(fx)
	assert_eq(c.take_damage(60, &"fire").final, 60, "damage is evaluated before crossing the threshold")
	assert_eq(c.take_damage(10, &"cold").final, 5)
	assert_eq(c.take_damage(10, &"force").final, 10)
	c.heal(100)
	assert_eq(c.resistance_source(&"cold"), "")

func test_bountiful_temp_hp_bonus_is_added_before_replacement_comparison() -> void:
	var c := TestChars.dummy(100)
	c.temp_hp = 10
	c.add_effect(Effect.new("Bountiful Health").with_modifier("temp_hp_bonus", {"value": 5}))
	assert_true(c.add_temp_hp(8))
	assert_eq(c.temp_hp, 13)
	assert_false(c.add_temp_hp(0), "a zero grant does not create Temporary HP")
	assert_eq(c.temp_hp, 13)

func test_fortifying_soul_selects_multiple_targets_and_expires() -> void:
	var e := TestCombat.open_field()
	var ch := TestChars.custom("ranger", "human", 7, {"ranger_subclass": ["winter_walker"]})
	var c := e.add(ch, &"party", Vector2i(2, 3))
	var ally := TestCombat.hero(e, "ilse_varga", Vector2i(3, 3))
	TestCombat.punching_bag(e, Vector2i(10, 3))
	TestCombat.start_with(e, c)
	ch.hp = 1
	ally.creature.hp = 1
	var catalog := ActionCatalog.new(e)
	var action := catalog.find(c, "feat:recipe:fortifying_soul")
	assert_eq(str(action["targeting"]), "multi")
	assert_eq(int(action["count"]), maxi(1, ch.ability_mod(&"wis")))
	assert_false(catalog.perform(c, action, [c, c]).ok)
	assert_true(c.action_available)
	assert_eq(ch.resource_left("fortifying_soul"), 1)
	assert_true(catalog.perform(c, action, [c, ally]).ok)
	assert_true(ch.hp >= 9 and ally.creature.hp >= 9)
	assert_eq(ch.resource_left("fortifying_soul"), 0)
	assert_true(c.magic_action_used)
	assert_false((ally.creature.d20_sources(["save_vs:frightened"])["advantage"] as Array).is_empty())
	var fx := ally.creature.effects.filter(func(x: Effect) -> bool: return x.source_id == "fortifying_soul")[0] as Effect
	assert_eq(fx.source_kind, &"feature")
	assert_eq(fx.minutes_left, 60)
	ally.creature.advance_minutes(59)
	assert_false((ally.creature.d20_sources(["save_vs:frightened"])["advantage"] as Array).is_empty())
	ally.creature.advance_minutes(1)
	assert_true((ally.creature.d20_sources(["save_vs:frightened"])["advantage"] as Array).is_empty())

func test_arcane_infiltrator_dodge_uses_bonus_and_resource() -> void:
	var e := TestCombat.open_field()
	var ch := TestChars.custom("wizard", "human", 3, {"versatile": ["arcane_infiltrator"]})
	# Use the real feature definition on an otherwise built character (origin pick keys vary by species).
	if not ch.features.any(func(f: Dictionary) -> bool: return str(f["id"]) == "arcane_infiltrator_benefit"):
		var f := ((Compendium.shared().feat_data("arcane_infiltrator")["benefits"] as Array)[-1] as Dictionary).duplicate(true)
		f["class_id"] = ""
		ch.features.append(f)
		ch.set_resource("arcane_infiltrator", "Arcane Infiltrator", ch.proficiency_bonus(), "long")
	var c := e.add(ch, &"party", Vector2i(2, 3))
	TestCombat.punching_bag(e, Vector2i(10, 3))
	TestCombat.start_with(e, c)
	var catalog := ActionCatalog.new(e)
	var action := catalog.find(c, "feat:recipe:arcane_infiltrator_benefit")
	assert_true(catalog.perform(c, action).ok)
	assert_true(c.action_available)
	assert_false(c.bonus_available)
	assert_eq(ch.resource_left("arcane_infiltrator"), ch.proficiency_bonus() - 1)
	assert_true(ch.effects.any(func(f: Effect) -> bool: return f.name == "Dodging"))

func test_divine_foreknowledge_restores_only_with_eligible_slot() -> void:
	var e := TestCombat.open_field()
	var ch := TestChars.custom("cleric", "human", 17, {"cleric_subclass": ["knowledge_domain"]})
	var c := e.add(ch, &"party", Vector2i(2, 3))
	TestCombat.punching_bag(e, Vector2i(10, 3))
	TestCombat.start_with(e, c)
	assert_true(e.feature_recipes.perform(c, "divine_foreknowledge", []).ok)
	assert_false((ch.d20_sources(["check:all"])["advantage"] as Array).is_empty())
	var slots := ch.slots_left(5)
	assert_false(e.feature_recipes.perform(c, "divine_foreknowledge", [], 5).ok)
	assert_eq(ch.slots_left(5), slots)
	assert_true(e.feature_recipes.perform(c, "divine_foreknowledge", [], 6).ok)
	assert_eq(ch.resource_left("divine_foreknowledge"), 1)
	assert_false(c.bonus_available)

func test_winter_polar_strikes_is_per_target_per_turn_and_excludes_unarmed() -> void:
	var e := TestCombat.open_field()
	var ch := TestChars.custom("ranger", "human", 11, {"ranger_subclass": ["winter_walker"]})
	var c := e.add(ch, &"party", Vector2i(2, 3))
	var a := TestCombat.punching_bag(e, Vector2i(3, 3))
	var b := TestCombat.punching_bag(e, Vector2i(3, 4))
	TestCombat.start_with(e, c)
	var p := WeaponProfile.new()
	p.item_id = "longsword"
	var option := {"kind": "weapon", "profile": p, "melee": true}
	var first := e.class_features.hit_dice(c, a, option, {})
	assert_true(first.any(func(d: Dictionary) -> bool: return str(d.get("label", "")) == "Polar Strikes" and str(d["dice"]) == "1d6"))
	assert_false(e.class_features.hit_dice(c, a, option, {}).any(func(d: Dictionary) -> bool: return str(d.get("label", "")) == "Polar Strikes"))
	assert_true(e.class_features.hit_dice(c, b, option, {}).any(func(d: Dictionary) -> bool: return str(d.get("label", "")) == "Polar Strikes"))
	e.end_turn()
	assert_true(e.class_features.hit_dice(c, a, option, {}).any(func(d: Dictionary) -> bool: return str(d.get("label", "")) == "Polar Strikes"), "it also works on another creature's turn")
	p.item_id = "unarmed_strike"
	assert_false(e.class_features.hit_dice(c, b, option, {}).any(func(d: Dictionary) -> bool: return str(d.get("label", "")) == "Polar Strikes"))

func test_winter_resistance_bypass_keeps_casting_class_provenance() -> void:
	var e := TestCombat.open_field()
	var ch := TestChars.custom("ranger", "human", 5, {"ranger_subclass": ["winter_walker"]})
	var c := e.add(ch, &"party", Vector2i(2, 3))
	var a := TestCombat.punching_bag(e, Vector2i(3, 3), 500)
	a.creature.base_resistances.append("cold")
	TestCombat.start_with(e, c)
	assert_eq(e.deal_damage(c, a, [{"amount": 20, "type": "cold", "weapon": true, "item": "longsword"}], false, "Weapon").final, 20)
	assert_eq(e.deal_damage(c, a, [{"amount": 20, "type": "cold", "weapon": true, "item": "unarmed_strike"}], false, "Unarmed").final, 10)
	var ctx := {"c": c, "nums": {"class_id": "ranger"}}
	assert_eq(e.spells.deal_spell_damage(ctx, a, [{"amount": 20, "type": "cold"}], false, "Spell").final, 20)
	ctx["nums"] = {"class_id": "wizard"}
	assert_eq(e.spells.deal_spell_damage(ctx, a, [{"amount": 20, "type": "cold"}], false, "Multiclass spell").final, 10)
	a.creature.base_immunities.append("cold")
	ctx["nums"] = {"class_id": "ranger"}
	assert_eq(e.spells.deal_spell_damage(ctx, a, [{"amount": 20, "type": "cold"}], false, "Spell").final, 0)

func test_hunters_rime_free_cast_blocks_disengage_and_transfers_with_mark() -> void:
	var e := TestCombat.open_field()
	var ch := TestChars.custom("ranger", "human", 5, {"ranger_subclass": ["winter_walker"]})
	var c := e.add(ch, &"party", Vector2i(2, 3))
	var a := TestCombat.punching_bag(e, Vector2i(3, 3), 500)
	var b := TestCombat.punching_bag(e, Vector2i(3, 4), 500)
	TestCombat.start_with(e, c)
	var r := e.spells.cast(c, "hunters_mark", 1, [a])
	assert_true(r.ok, r.reason)
	assert_true(ch.temp_hp >= 6 and ch.temp_hp <= 15)
	assert_false(e.can_disengage(a))
	assert_true(e.can_disengage(b))
	var hp := ch.temp_hp
	a.creature.hp = 0
	while true:
		e.end_turn()
		if e.current() == c:break
	var action := e.spells.sustained_for(c, "hunters_mark")
	assert_true(e.spells.use_sustained(c, str(action["id"]), [b]).ok)
	assert_true(e.can_disengage(a))
	assert_false(e.can_disengage(b))
	assert_eq(ch.temp_hp, hp, "moving the mark is not another casting")
	ch.concentration.end("test")
	assert_true(e.can_disengage(b))

func _give_feat(ch: Character, id: String) -> void:
	var feat := Compendium.shared().feat_data(id)
	for raw: Variant in feat["benefits"]:
		var f := (raw as Dictionary).duplicate(true)
		f["class_id"] = ""
		ch.features.append(f)
		if f.has("resource"):
			var res := f["resource"] as Dictionary
			ch.set_resource(str(res["id"]), str(res["name"]), Formula.evaluate(res["max"], ch.formula_context()), str(res["recharge"]))
		for md: Variant in f.get("modifiers", []):
			ch.add_effect(Effect.new(str(f["name"]), &"feat", str(f["id"])).with_modifier(str(md["stat"]), md as Dictionary))

func test_roll_responses_filter_magic_reaction_costs_and_targets() -> void:
	var e := TestCombat.open_field()
	var ch := TestChars.custom("wizard", "human", 4)
	_give_feat(ch, "arcane_omens")
	var helper := e.add(ch, &"party", Vector2i(2, 3))
	var ally := TestCombat.hero(e, "ilse_varga", Vector2i(3, 3))
	var enemy := TestCombat.punching_bag(e, Vector2i(9, 3))
	TestCombat.start_with(e, helper)
	var check := D20Test.from_natural(D20Test.Kind.ABILITY_CHECK, 5, 0, 15)
	e.feature_recipes.after_d20(ally, check, ["check:wis"])
	assert_true(helper.reaction_available)
	var save := D20Test.from_natural(D20Test.Kind.SAVING_THROW, 14, 0, 15)
	e.feature_recipes.after_d20(ally, save, ["save:wis", "save:all"])
	assert_true(save.success)
	assert_false(helper.reaction_available)
	assert_eq(ch.resource_left("arcane_omens_benefit"), ch.proficiency_bonus() - 1)
	helper.reaction_available = true
	var hostile := D20Test.from_natural(D20Test.Kind.SAVING_THROW, 14, 0, 15)
	e.feature_recipes.after_d20(enemy, hostile, ["save:wis"])
	assert_false(hostile.success)
	assert_true(helper.reaction_available)

func test_spell_resistance_bonus_only_spends_on_failed_magical_save() -> void:
	var e := TestCombat.open_field()
	var ch := TestChars.custom("fighter", "human", 4)
	_give_feat(ch, "spell_resistant")
	var c := e.add(ch, &"party", Vector2i(2, 3))
	TestCombat.punching_bag(e, Vector2i(9, 3))
	TestCombat.start_with(e, c)
	var save := D20Test.from_natural(D20Test.Kind.SAVING_THROW, 14, 0, 15)
	e.feature_recipes.after_d20(c, save, ["save:con"])
	assert_false(save.success)
	assert_eq(ch.resource_left("spell_resistant_save"), ch.proficiency_bonus())
	e.feature_recipes.after_d20(c, save, ["save:con", "save_vs:spell"])
	assert_true(save.success)
	assert_true(c.reaction_available, "Magic Resistant does not cost a Reaction")
	assert_eq(ch.resource_left("spell_resistant_save"), ch.proficiency_bonus() - 1)

func test_fortunes_favor_recharges_at_owners_start_only() -> void:
	var e := TestCombat.open_field()
	var ch := TestChars.custom("wizard", "human", 19)
	_give_feat(ch, "boon_of_fortunes_favor")
	var c := e.add(ch, &"party", Vector2i(2, 3))
	var t := TestCombat.punching_bag(e, Vector2i(9, 3))
	TestCombat.start_with(e, c)
	var save := D20Test.from_natural(D20Test.Kind.SAVING_THROW, 19, 0, 20)
	TestCombat.next_d20(e, 2)
	e.feature_recipes.after_d20(c, save, ["save:wis"])
	assert_eq(save.kept, 2, "must keep a worse result")
	assert_eq(ch.resource_left("boon_of_fortunes_favor_benefit"), 0)
	ch.on_turn_start(t.id)
	assert_eq(ch.resource_left("boon_of_fortunes_favor_benefit"), 0)
	ch.on_turn_start(c.id)
	assert_eq(ch.resource_left("boon_of_fortunes_favor_benefit"), 1)

func test_iron_mind_and_focused_conjuration_protect_only_the_stated_breaks() -> void:
	var ch := TestChars.custom("wizard", "human", 19)
	_give_feat(ch, "boon_of_the_iron_mind")
	var concentration := ch.begin_concentration("bless", "Bless")
	var hit := ch.take_damage(1, &"force", false, DiceRoller.new(1))
	assert_eq(hit.concentration_dc, 0)
	ch.add_condition(&"stunned", "test")
	assert_false(concentration.ended)
	ch.add_condition(&"petrified", "test")
	assert_true(concentration.ended)
	var conjurer := TestChars.custom("wizard", "human", 10, {"wizard_subclass": ["conjurer"]})
	conjurer.begin_concentration("summon_fey", "Summon Fey")
	assert_true(conjurer.concentration_damage_protected())
	conjurer.begin_concentration("bless", "Bless")
	assert_false(conjurer.concentration_damage_protected())

func test_benign_transposition_swap_range_upgrade_and_resource_restoration() -> void:
	var e := TestCombat.open_field()
	var ch := TestChars.custom("wizard", "human", 6, {"wizard_subclass": ["conjurer"]})
	var c := e.add(ch, &"party", Vector2i(2, 3))
	var ally := TestCombat.hero(e, "ilse_varga", Vector2i(5, 3))
	var enemy := TestCombat.punching_bag(e, Vector2i(9, 3))
	TestCombat.start_with(e, c)
	var before := ch.resource_left("benign_transposition")
	assert_true(before >= 1)
	assert_false(e.feature_recipes.perform(c, "benign_transposition", [], 0, enemy.cell).ok)
	assert_eq(ch.resource_left("benign_transposition"), before)
	assert_true(c.bonus_available)
	assert_true(e.feature_recipes.perform(c, "benign_transposition", [], 0, ally.cell).ok)
	assert_eq(c.cell, Vector2i(5, 3))
	assert_eq(ally.cell, Vector2i(2, 3))
	assert_eq(ch.resource_left("benign_transposition"), before - 1)
	assert_false(c.bonus_available)
	var slots := ch.slots_left(3)
	assert_true(e.feature_recipes.perform(c, "benign_transposition", [], 3).ok)
	assert_eq(ch.slots_left(3), slots - 1)
	assert_eq(ch.resource_left("benign_transposition"), before)
	var action := ActionCatalog.new(e).find(c, "feat:recipe:benign_transposition")
	assert_eq(int(action["range"]), 60)

func test_durable_summons_requires_slot_and_tracks_its_temporary_hp() -> void:
	var e := TestCombat.open_field()
	var ch := TestChars.custom("wizard", "human", 6, {"wizard_subclass": ["conjurer"]})
	(ch.spellcasting[0]["prepared"] as Array).append("summon_beast")
	var c := e.add(ch, &"party", Vector2i(2, 3))
	TestCombat.punching_bag(e, Vector2i(10, 3))
	TestCombat.start_with(e, c)
	assert_true(e.spells.cast(c, "summon_beast", 2, [], Vector2(4.5, 3.5)).ok)
	var ids := e.spells.summoned[c.id] as Array
	var summon := e.get_c(str(ids.back()))
	assert_eq(summon.creature.temp_hp, 12)
	assert_eq(summon.creature.resistance_source(&"fire"), "Durable Summons")
	assert_eq(summon.creature.resistance_source(&"force"), "")
	summon.creature.add_temp_hp(20, "Replacement")
	assert_eq(summon.creature.resistance_source(&"fire"), "", "benefit is bound to these Temporary Hit Points")
	var free := TestChars.dummy(100)
	e.feature_recipes.after_summon({"c": c, "s": Compendium.shared().spell_data("summon_beast"), "slot": 2}, free)
	assert_eq(free.temp_hp, 0, "a slot level alone does not mean a slot was spent")

func test_splintered_summons_validates_two_spaces_and_shares_concentration() -> void:
	var e := TestCombat.open_field()
	var ch := TestChars.custom("wizard", "human", 14, {"wizard_subclass": ["conjurer"]})
	(ch.spellcasting[0]["prepared"] as Array).append("summon_beast")
	var c := e.add(ch, &"party", Vector2i(2, 3))
	TestCombat.punching_bag(e, Vector2i(10, 3))
	TestCombat.start_with(e, c)
	var action := ActionCatalog.new(e).find(c, "spell:summon_beast:splintered")
	assert_false(action.is_empty())
	assert_eq(str(action["targeting"]), "points")
	var before := ch.slots_left(2)
	assert_false(e.spells.cast(c, "summon_beast", 2, [], Vector2(4.5, 3.5), Vector2.ZERO,
		{"splintered": true, "choice": "land", "points": [Vector2(4.5, 3.5), Vector2(4.5, 3.5)]}).ok)
	assert_eq(ch.slots_left(2), before)
	assert_eq(ch.resource_left("splintered_summons"), 1)
	assert_true(c.action_available)
	assert_true(e.spells.cast(c, "summon_beast", 2, [], Vector2(4.5, 3.5), Vector2.ZERO,
		{"splintered": true, "choice": "land", "points": [Vector2(4.5, 3.5), Vector2(5.5, 4.5)]}).ok)
	var ids := e.spells.summoned[c.id] as Array
	assert_eq(ids.size(), 2)
	var ordinary := Monster.from_data(SummonBlocks.for_spell("summon_beast", 2, "land", {}))
	for id: Variant in ids:
		var spirit := e.get_c(str(id))
		assert_eq(spirit.creature.max_hp(), ordinary.max_hp() / 2)
		assert_eq(spirit.creature.hp, ordinary.max_hp() / 2)
		assert_eq(spirit.creature.temp_hp, 28)
		assert_true(spirit.is_player_controlled())
	assert_eq(ch.resource_left("splintered_summons"), 0)
	assert_true(e.feature_recipes.perform(c, "splintered_summons", [], 5).ok)
	assert_eq(ch.resource_left("splintered_summons"), 1)
	ch.concentration.end("test")
	for id: Variant in ids:
		assert_false(e.get_c(str(id)).is_alive())


func test_conjuration_adept_uses_selected_ability_only_for_matching_concentration() -> void:
	var ch := TestChars.custom("wizard", "human", 4, {"ability_score_improvement": ["conjuration_adept"], "conjuration_adept.abilities": ["wis"]})
	var mods := ch.modifiers_for(&"concentration_save_bonus")
	assert_eq(mods.size(), 1)
	assert_eq(mods[0].text("ability"), "wis")
	ch.begin_concentration("entangle", "Entangle")
	var plain := ch.save_bonus(&"con").total()
	var save := ch.roll_save(DiceRoller.new(42), &"con", 10, [], [], "Concentration", ["concentration"])
	assert_eq(save.breakdown.total(), plain + ch.ability_mod(&"wis"))
	var other := ch.roll_save(DiceRoller.new(42), &"con", 10)
	assert_eq(other.breakdown.total(), plain)
	ch.begin_concentration("slow", "Slow")
	other = ch.roll_save(DiceRoller.new(42), &"con", 10, [], [], "Concentration", ["concentration"])
	assert_eq(other.breakdown.total(), plain)

func test_transmutation_adept_requires_paid_slot_and_own_turn_then_expires() -> void:
	var e := TestCombat.open_field()
	var ch := TestChars.custom("wizard", "human", 4, {"ability_score_improvement": ["transmutation_adept"]})
	var c := e.add(ch, &"party", Vector2i(2, 3))
	var foe := TestCombat.punching_bag(e, Vector2i(10, 3))
	TestCombat.start_with(e, c)
	var speed := ch.speed().total()
	assert_true(e.spells.cast(c, "jump", 2, [c]).ok)
	assert_eq(ch.speed().total(), speed + 10, "uses the actual slot level")
	e.end_turn()
	assert_eq(ch.speed().total(), speed)
	assert_eq(e.current(), foe)
	e.spells._after_cast_features({"c": c, "s": Compendium.shared().spell_data("jump"), "slot": 2}, false)
	assert_eq(ch.speed().total(), speed, "an off-turn spell does not trigger the bonus")
	e.end_turn()
