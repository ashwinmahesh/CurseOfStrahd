func test_frozen_haunt_choice_pulse_resources_and_concentration_lifecycle() -> void:
	var e := TestCombat.open_field()
	var ch := TestChars.custom("ranger", "human", 15, {"ranger_subclass": ["winter_walker"]})
	var c := e.add(ch, &"party", Vector2i(2, 3))
	var target := TestCombat.punching_bag(e, Vector2i(5, 3), 500)
	var ally := e.add(TestChars.dummy(500), &"party", Vector2i(3, 3))
	var far := TestCombat.punching_bag(e, Vector2i(11, 7), 500)
	target.creature.base_resistances.append("cold")
	c.reaction_rules["frozen_haunt_pulse"] = "ask"
	TestCombat.start_with(e, c)
	var catalog := ActionCatalog.new(e)
	var action := catalog.find(c, "spell:hunters_mark:frozen_haunt")
	assert_false(action.is_empty())
	assert_true(catalog.perform(c, action, [target]).ok)
	assert_true(ch.has_flag("frozen_haunt"))
	assert_eq(ch.resource_left("frozen_haunt"), 0)
	assert_eq(ch.take_damage(100, &"cold").final, 0)
	for condition: StringName in [&"grappled", &"prone", &"restrained"]:
		assert_false(ch.add_condition(condition, "test"))
	assert_true(e.pending != null)
	assert_false(e.pending.spends_reaction)
	assert_true(e.pending.target_choices.any(func(o: Dictionary) -> bool: return str(o["id"]) == ally.id))
	assert_false(e.pending.target_choices.any(func(o: Dictionary) -> bool: return str(o["id"]) == far.id))
	e.pending.selected_ids.assign([target.id, ally.id, far.id])
	assert_true(e.answer_reaction(true).ok)
	assert_true(c.reaction_available)
	assert_eq(target.creature.hp, ally.creature.hp, "Ranger feature Cold ignores Resistance")
	assert_true(target.creature.hp < 500)
	assert_eq(far.creature.hp, 500, "choices are revalidated when the prompt resolves")
	var slots := ch.slots_left(4)
	assert_true(e.feature_recipes.perform(c, "frozen_haunt", [], 4).ok)
	assert_eq(ch.slots_left(4), slots - 1)
	assert_eq(ch.resource_left("frozen_haunt"), 1)
	c.creature.concentration.end("test")
	assert_false(ch.has_flag("frozen_haunt"))
	assert_false(ch.is_condition_immune(&"grappled"))
	assert_eq(ch.take_damage(10, &"cold").final, 5, "normal Frost Resistance remains")

func test_frozen_haunt_pulses_at_turn_start_and_can_end_inside_creature() -> void:
	var e := TestCombat.open_field()
	var ch := TestChars.custom("ranger", "human", 15, {"ranger_subclass": ["winter_walker"]})
	var c := e.add(ch, &"party", Vector2i(2, 3))
