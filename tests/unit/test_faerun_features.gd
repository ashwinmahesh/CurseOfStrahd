	var c := e.add(ch, &"party", Vector2i(2, 3))
	var near := TestCombat.punching_bag(e, Vector2i(3, 3), 500)
	var far := TestCombat.punching_bag(e, Vector2i(4, 3), 500)
	near.creature.base_immunities.append("cold")
	c.reaction_rules["ember_form_pulse"] = "ask"
	TestCombat.start_with(e, c)
	var catalog := ActionCatalog.new(e)
	assert_false(e.spells.cast(c, "hunters_mark", 1, [near], Vector2.INF, Vector2.ZERO, {"cast_form": "unknown"}).ok)
	assert_true(c.bonus_available)
	assert_eq(ch.resource_left("ember_uses"), 1)
	var action := catalog.find(c, "spell:hunters_mark:ember_form")
	assert_false(action.is_empty())
	assert_true(catalog.perform(c, action, [near]).ok)
	assert_eq(ch.resource_left("ember_uses"), 0)
	assert_eq(ch.take_damage(20, &"acid").final, 0)
	assert_false(ch.has_flag("incorporeal_movement"), "movement comes only from the recipe")
	assert_true(e.pending != null)
	if e.pending == null:return
	assert_eq(e.pending.kind, "ember_form_pulse")
	assert_false(e.pending.target_choices.any(func(t: Dictionary) -> bool: return str(t["id"]) == far.id))
	e.pending.selected_ids.assign([near.id, far.id])
	assert_true(e.answer_reaction(true).ok)
	assert_true(near.creature.hp >= 496 and near.creature.hp < 500, "recipe Fire damages a Cold-immune target")
	assert_eq(far.creature.hp, 500)
	e.triggered_features.turn_start(c)
	assert_true(e.pending != null)
	ch.concentration.end("form ended while selecting")
	var hp := near.creature.hp
	assert_true(e.answer_reaction(true).ok)
	assert_eq(near.creature.hp, hp, "an ended form cannot apply a delayed pulse")
	assert_eq(ch.take_damage(20, &"acid").final, 20)

func test_attack_recipes_use_class_filter_and_configured_weapon_restrictions() -> void:
	var e := TestCombat.open_field()
	var ch := TestChars.custom("wizard", "human", 3)
	(ch.spellcasting[0]["cantrips"] as Array).append("fire_bolt")
	ch.features.append({"id": "arcane_riposte", "action": "passive", "summary": "", "name": "Arcane Riposte", "after_cast_attack": {
		"casting_time": "action", "weapons_only": false, "allow_ranged": false}})
	ch.features.append({"id": "alternate_cantrip", "action": "passive", "summary": "", "name": "Alternate Cantrip", "attack_cantrip": {"class": "cleric"}})
	var c := e.add(ch, &"party", Vector2i(2, 3))
	c.reaction_rules["heroic_inspiration"] = "never"
	var target := TestCombat.punching_bag(e, Vector2i(8, 3), 500)
	TestCombat.start_with(e, c)
	var catalog := ActionCatalog.new(e)
	assert_true(catalog.find(c, "war_magic:fire_bolt").is_empty(), "the spell's casting class must match")
	(ch.features[-1]["attack_cantrip"] as Dictionary)["class"] = "wizard"
	var attack := catalog.find(c, "war_magic:fire_bolt")
	assert_false(attack.is_empty())
	assert_true(catalog.perform(c, attack, [target]).ok)
	assert_false(c.action_available)
	assert_eq(c.bonus_attack, "Arcane Riposte")
	var actions := e.feature_actions.list(c)
	assert_true(actions.any(func(a: Dictionary) -> bool: return str(a["id"]).begins_with("feat:bonus_attack:arcane_riposte:") and str(a["id"]).contains("unarmed")))
	c.bonus_attack = "Another benefit"
	assert_false(e.feature_actions.list(c).any(func(a: Dictionary) -> bool: return str(a["id"]).contains("arcane_riposte")), "a replaced attack does not inherit the previous trigger's label")

func test_resource_restore_recipe_requires_successful_positive_expenditure() -> void:
	var ch := TestChars.custom("wizard", "human", 1)
	ch.set_resource("trigger_pool", "Trigger Pool", 2, "long")
	ch.set_resource("restored_pool", "Restored Pool", 3, "long")
	assert_true(ch.spend_resource("restored_pool", 3))
	ch.add_effect(Effect.new("Linked Pools").with_modifier("resource_restore", {
		"when_spent": "trigger_pool", "resource": "restored_pool", "value": 2}))
	assert_true(ch.spend_resource("trigger_pool", 0))
	assert_eq(ch.resource_left("restored_pool"), 0)
	assert_false(ch.spend_resource("trigger_pool", 3))
	assert_eq(ch.resource_left("restored_pool"), 0)
	assert_true(ch.spend_resource("trigger_pool"))
	assert_eq(ch.resource_left("restored_pool"), 2)
	assert_true(ch.spend_resource("trigger_pool"))
	assert_eq(ch.resource_left("restored_pool"), 3, "restoration is capped at the pool maximum")
