func test_hypnotic_presence_ends_on_range_or_lost_senses_and_respects_charm_immunity() -> void:
	var e := TestCombat.open_field()
	var ch := TestChars.custom("wizard", "human", 3, {"wizard_subclass": ["enchanter"]})
