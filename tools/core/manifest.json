{
  "summary": "What moves into the private core repo DndCoreEngine (submodule addons/dnd_core), docs/plans/engine_split.md. Paths are relative to the game repo and keep their place in the core. `include` and `exclude` are globs (** crosses folders); a .gd file brings its .uid.",
  "include": [
    "rules/**",
    "combat/**",
    "story/**",
    "data/campaign.json",
    "data/schemas/*.schema.json",
    "tests/test_case.gd",
    "tests/test_runner.gd",
    "tests/test_runner.tscn",
    "tools/run_tests.py",
    "tools/logcheck.sh",
    "tools/lint_gd.sh",
    "tools/godot_slot.sh",
    "tools/data/*.py"
  ],
  "exclude": [
    "story/tarokka.gd",
    "story/strahd_presence.gd",
    "story/oracles.gd",
    "story/endings.gd",
    "story/cheat_codes.gd",
    "story/strahd_campaign.gd",
    "data/campaign.json",
    "data/schemas/tarokka_*.schema.json",
    "data/schemas/strahd_*.schema.json",
    "data/schemas/ending.schema.json",
    "data/schemas/ally_visits.schema.json",
    "data/schemas/night_visitors.schema.json",
    "tools/data/cheat_codes.py"
  ],
  "data_folders": ["classes", "subclasses", "species", "backgrounds", "feats", "spells", "items", "magic_items", "monsters", "conditions"],
  "data_leave_in_game_books": ["CoS", "custom"],
  "campaign_names": ["strahd", "barovi", "ravenloft", "tarokka", "vallaki", "krezk", "ireena", "ezmerelda", "izek", "rahadin",
    "amber_temple", "death_house", "sunsword", "heart_of_sorrow", "argynvost", "vistan", "svalich", "yester_hill",
    "wachter", "kolyan", "ismark", "lysaga", "vasilka", "mongrelfolk", "kasimir", "van_richten", "madam_eva", "berez",
    "tsolenka", "gundarak", "wizard_of_wines", "blood_of_the_vine"],
  "unit_tests": "every tests/unit/test_*.gd that names no campaign id and uses only classes that move too (worked out by tools/core/extract.py)"
}
