extends Node
## Offscreen mobile Skirmish and secondary surfaces, using isolated setup state.

func capture_shots(tool: Node, out: String) -> void:
	SkirmishLibrary.dir = "user://mobile_secondary_capture/"
	SkirmishScreen.current = SkirmishSetup.new()
	SkirmishScreen.kept_tab = "Party"
	var setup := SkirmishScreen.new()
	add_child(setup)
	await tool.call("wait_frames", 12)
	tool.call("_shot", out + "_add_hero.png")
	setup.setup.add_hero(Pregens.build("godrick_pendlebrook", 5))
	setup.setup.add_foe("zombie")
	setup._select_hero(0)
	for tab: String in SkirmishScreen.TABS:
		setup.tab = tab
		setup._redraw()
		await tool.call("wait_frames", 12)
		tool.call("_shot", out + "_skirmish_" + tab.to_lower() + ".png")
	setup.tab = "Field"
	setup._redraw()
	await tool.call("wait_frames", 8)
	var page := setup.mobile.body.get_parent().get_parent().get_parent() as MobilePage
	page.scroll.ensure_control_visible(setup.mobile.map_scroll)
	await tool.call("wait_frames", 8)
	tool.call("_shot", out + "_placement_map.png")
	setup.mobile.pick_cell(Vector2i(2, 2))
	page.scroll.ensure_control_visible(setup.mobile.review)
	await tool.call("wait_frames", 8)
	tool.call("_shot", out + "_placement_review.png")
	setup.mobile._fight_review()
	await tool.call("wait_frames", 12)
	tool.call("_shot", out + "_fight_review.png")
	setup.queue_free()
	await tool.call("wait_frames", 2)
	var achievements := AchievementsPanel.open(self)
	await tool.call("wait_frames", 12)
	tool.call("_shot", out + "_achievements.png")
	achievements.queue_free()
	await tool.call("wait_frames", 2)
	var encounter := TestCombat.open_field()
	var hero := TestCombat.hero(encounter, "godrick_pendlebrook", Vector2i(2, 2), 5)
	TestCombat.foe(encounter, "zombie", Vector2i(5, 2))
	TestCombat.start_with(encounter, hero)
	var results := SkirmishResults.new()
	add_child(results)
	results.show_for(encounter, "Practice field", ["A difficult victory"])
	await tool.call("wait_frames", 12)
	tool.call("_shot", out + "_results.png")
	results.queue_free()
	await tool.call("wait_frames", 2)
	var prompt := GuidancePrompt.ask(self, {"who": hero.creature, "skill": &"perception", "dc": 15, "casters": [{"caster": hero.creature, "ends": "Protection from Evil and Good"}]}, func(_index: int, _rule: String) -> void: pass)
	await tool.call("wait_frames", 12)
	tool.call("_shot", out + "_guidance.png")
	prompt.queue_free()
	await tool.call("wait_frames", 2)
	var layer := CanvasLayer.new()
	add_child(layer)
	var cutscene := CutsceneView.new()
	layer.add_child(cutscene)
	cutscene.show_image("res://art/ui/title_backdrop.png")
	cutscene.show_caption(true)
	cutscene.caption("Narrator", "Mist covers the road ahead. Behind the gates, a lonely village waits in the shadow of Castle Ravenloft. You hear a distant bell, and the slow creak of a sign over the inn door.")
	await tool.call("wait_frames", 12)
	tool.call("_shot", out + "_cutscene.png")
	cutscene.set_paused(true)
	await tool.call("wait_frames", 12)
	tool.call("_shot", out + "_cutscene_pause.png")
	layer.queue_free()
	await tool.call("wait_frames", 2)
	var coach := TutorialCoach.new()
	add_child(coach)
	coach.present({"read_only": true, "title": "Your first adventure", "body": "Tap an action to inspect it, then confirm to commit. Scrolling a list never selects an action.", "objective": "Learn at your own pace.", "details": "Use the visible camera controls or drag to pan and pinch to zoom."}, 0, 10)
	coach.set_complete("Ready to begin.")
	await tool.call("wait_frames", 12)
	tool.call("_shot", out + "_tutorial.png")
	coach.show_menu()
	await tool.call("wait_frames", 12)
	tool.call("_shot", out + "_tutorial_menu.png")
	coach.queue_free()

	await tool.call("wait_frames", 2)
	var card := LoadingCard.new()
	card.location = {"name": "Castle Ravenloft", "region": "castle_ravenloft"}
	card.tip = "Inspect an action before confirming it. You can pan the battlefield and read its targets without spending your turn."
	card.hold = 120
	add_child(card)
	await tool.call("wait_frames", 12)
	card._root.modulate.a = 1
	tool.call("_shot", out + "_loading.png")
	card.queue_free()
	await tool.call("wait_frames", 2)
	var state := StoryState.new()
	state.party.append(Pregens.build("godrick_pendlebrook", 10))
	var ending := EndingScreen.new()
	ending.to_title = false
	ending.save_on_finish = false
	add_child(ending)
	ending.play(state, Endings.all()[0])
	await tool.call("wait_frames", 12)
	tool.call("_shot", out + "_ending_title.png")
	ending._show_beat({"kind": "line", "narrator": true, "text": "The mist lifts over Barovia. The road is open at last, and the company can rest beneath a clear dawn sky."})
	await tool.call("wait_frames", 12)
	tool.call("_shot", out + "_ending_narration.png")
	ending._to_end()
	ending.show_tally()
	await tool.call("wait_frames", 12)
	tool.call("_shot", out + "_ending_tally.png")
	ending.queue_free()
