# Git LFS (owner decision 2026-10-07): new or changed big art and audio go to LFS. Files already in the history stay
# plain blobs (no `git lfs migrate`, no rewritten history); a file under these patterns becomes an LFS pointer the next
# time it changes. Godot's .import sidecars and .tres resources stay in plain git.
art/generated/**/*.png filter=lfs diff=lfs merge=lfs -text
art/generated/**/*.jpg filter=lfs diff=lfs merge=lfs -text
art/generated/**/*.webp filter=lfs diff=lfs merge=lfs -text
art/sprites/**/*.png filter=lfs diff=lfs merge=lfs -text
art/portraits/**/*.png filter=lfs diff=lfs merge=lfs -text
art/creator/**/*.png filter=lfs diff=lfs merge=lfs -text
art/textures/**/*.png filter=lfs diff=lfs merge=lfs -text
art/textures/**/*.webp filter=lfs diff=lfs merge=lfs -text
audio/voice/**/*.mp3 filter=lfs diff=lfs merge=lfs -text
# Sound packs (art/sourced/<pack>/, read by core/audio.gd through art/audio.json): new or changed clips go to LFS too.
art/sourced/**/*.wav filter=lfs diff=lfs merge=lfs -text
art/sourced/**/*.ogg filter=lfs diff=lfs merge=lfs -text
art/sourced/**/*.mp3 filter=lfs diff=lfs merge=lfs -text
# The Modern look's leaf cards (tools/art/plant_cards.py, docs/art/plants.md).
art/plants/**/*.png filter=lfs diff=lfs merge=lfs -text
# Story cutscenes' full-screen pictures (story/cutscenes.gd, docs/ui/cutscenes.md).
art/cutscenes/**/*.png filter=lfs diff=lfs merge=lfs -text
