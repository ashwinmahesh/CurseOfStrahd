{
  "$id": "species.schema.json",
  "title": "Species",
  "type": "object",
  "required": ["id", "name", "source", "creature_type", "sizes", "speed", "traits"],
  "additionalProperties": false,
  "properties": {
    "id": {"$ref": "common.schema.json#/$defs/id"},
    "name": {"type": "string"},
    "source": {"$ref": "common.schema.json#/$defs/source"},
    "creature_type": {"type": "string", "enum": ["humanoid"]},
    "sizes": {"type": "array", "minItems": 1, "items": {"$ref": "common.schema.json#/$defs/size"}},
    "speed": {"type": "integer", "minimum": 0},
    "darkvision": {"type": "integer", "minimum": 0},
    "traits": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/feature"}},
    "lineages": {"type": "array", "description": "Sub-choices such as elf lineages, tiefling legacies, dragonborn ancestry.", "items": {"type": "object", "required": ["id", "name"], "properties": {"id": {"$ref": "common.schema.json#/$defs/id"}, "name": {"type": "string"}, "traits": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/feature"}}}}}
  }
}
