{
  "$id": "random_table.schema.json",
  "title": "A random encounter table for travel",
  "type": "object",
  "required": [
    "id",
    "map",
    "chance_day",
    "chance_night",
    "entries"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "map": {
      "type": "string"
    },
    "chance_day": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "chance_night": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "summary": {
      "type": "string"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "weight"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "weight": {
            "type": "integer",
            "minimum": 1
          },
          "when": {
            "type": "string"
          },
          "monsters": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "monster",
                "cell"
              ],
              "additionalProperties": false,
              "properties": {
                "monster": {
                  "$ref": "common.schema.json#/$defs/id"
                },
                "cell": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 2,
                  "items": {
                    "type": "integer"
                  }
                },
                "name": {
                  "type": "string"
                },
                "hp": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          },
          "dialogue": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "once": {
            "type": "boolean"
          },
          "surprise": {
            "enum": [
              "",
              "party",
              "enemies"
            ]
          }
        }
      }
    }
  }
}
