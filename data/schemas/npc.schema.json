{
  "$id": "npc.schema.json",
  "title": "Named NPC",
  "type": "object",
  "required": [
    "id",
    "name",
    "summary"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "name": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "portrait": {
      "type": "string"
    },
    "looks": {
      "type": "array",
      "description": "Portraits the story switches to (story/npc_looks.gd): the first whose dialogue condition holds wins.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["when", "portrait"],
        "properties": {"when": {"type": "string"}, "portrait": {"type": "string"}}
      }
    },
    "sprite": {
      "type": "string"
    },
    "attitude": {
      "type": "string",
      "enum": [
        "hostile",
        "indifferent",
        "friendly"
      ]
    },
    "voice": {
      "type": "string"
    },
    "monster": {
      "type": "string"
    },
    "guest": {
      "type": "boolean"
    },
    "guest_fights": {
      "type": "boolean",
      "description": "false: this guest keeps out of every fight (Ireena, Ashwin 2026-10-18). She takes no turn, no foe can target her and no area spell of either side catches her, because she is not in the encounter at all; her figure stays on the board as a bystander whose square blocks, stepped aside if the fight starts on it. Needs guest: true. Without it guests fight under the player's control (docs/contracts/campaign.md)."
    },
    "leaves_after_fight": {
      "type": "boolean",
      "description": "A guest who stays for one fight only: StoryState.release_one_fight_guests sends them away when the next fight ends (Sir Klutz's ghost)."
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "region": {
      "type": "string"
    },
    "pronouns": {
      "type": "string"
    },
    "shop": {
      "type": "object",
      "required": [
        "sells"
      ],
      "additionalProperties": false,
      "properties": {
        "sells": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "$ref": "common.schema.json#/$defs/id"
              },
              "qty": {
                "type": "integer",
                "minimum": -1
              },
              "price": {
                "type": "number",
                "minimum": 0
              },
              "if": {
                "type": "string",
                "description": "A story condition; the line is for sale only while it holds."
              },
              "sets": {
                "$ref": "common.schema.json#/$defs/id",
                "description": "A flag set when the party buys one (Bildrath's one potion)."
              },
              "counts": {
                "$ref": "common.schema.json#/$defs/id",
                "description": "An int flag that counts the pieces bought (Morgantha's pastries)."
              },
              "markup": {
                "type": "number",
                "minimum": 0,
                "description": "This line's markup instead of the shop's."
              }
            }
          }
        },
        "magic": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "description": "Magic items for sale (Ashwin, 2026-10-14; story/trade.gd magic_stock): each at its own price (Sane Magical Prices) whatever the shop's markup, shown once the party's milestone level reaches its rarity's (data/treasure/levels.json shop_levels). A template on a weapon or armor ('flame_tongue') lets the party pick the base."
        },
        "magic_if": {
          "type": "string",
          "description": "A story condition the magic stock waits for (the Keepers' stores)."
        },
        "buys": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "markup": {
          "type": "number",
          "minimum": 0
        },
        "sell_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "closed": {
          "type": "string"
        },
        "haggle": {
          "type": "object",
          "additionalProperties": false,
          "description": "U11: the Persuasion haggle (story/trade.gd). dc defaults to 15; won/lost name flags the shop's dialogue shares, and a lost flag makes a failure final.",
          "properties": {
            "dc": {
              "type": "integer",
              "minimum": 1,
              "maximum": 30
            },
            "won": {
              "$ref": "common.schema.json#/$defs/id"
            },
            "lost": {
              "$ref": "common.schema.json#/$defs/id"
            }
          }
        },
        "price_flags": {
          "type": "array",
          "description": "Price changes while a condition holds: buy is a factor on what the party pays, for wares whose shop price is at least min_price.",
          "items": {
            "type": "object",
            "required": [
              "if",
              "buy"
            ],
            "additionalProperties": false,
            "properties": {
              "if": {
                "type": "string"
              },
              "buy": {
                "type": "number",
                "minimum": 0
              },
              "min_price": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        },
        "rotating": {
          "type": "object",
          "additionalProperties": false,
          "description": "F14: stock that changes: count things from pool (or from each of groups), one of each, picked again every days days.",
          "properties": {
            "pool": {
              "type": "array",
              "items": {
                "$ref": "common.schema.json#/$defs/id"
              },
              "minItems": 1
            },
            "count": {
              "type": "integer",
              "minimum": 1
            },
            "days": {
              "type": "integer",
              "minimum": 1
            },
            "groups": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "pool"
                ],
                "additionalProperties": false,
                "properties": {
                  "pool": {
                    "type": "array",
                    "items": {
                      "$ref": "common.schema.json#/$defs/id"
                    },
                    "minItems": 1
                  },
                  "count": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              }
            }
          }
        },
        "hide_closed": {
          "type": "boolean",
          "description": "While closed, the right-click menu shows no Trade (a merchant the story unlocks)."
        }
      }
    },
    "guest_build": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "monster": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "pregen": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "level": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "note": {
          "type": "string"
        }
      }
    },
    "guest_stays": {
      "type": "array",
      "description": "What keeps a guest in the party: Send home and a fall in a fight leave them be while a rule's `when` holds, and `why` is said instead (StoryState.guest_stays). Madam Eva's ally always stays.",
      "items": {
        "type": "object",
        "required": ["why"],
        "additionalProperties": false,
        "properties": {"when": {"type": "string"}, "why": {"type": "string"}}
      }
    },
    "guest_talk": {
      "type": "string",
      "description": "The conversation a click on this guest opens while they travel with the party (a dialogue ref 'file/key:node'; GuestTalk.ref_for). Without one they say one of their road lines instead."
    },
    "gifts": {
      "type": "array",
      "description": "What the party can hand this guest while they travel with it (the Give... choice, GuestTalk.gifts): each is offered while its `when` condition holds, and starts the conversation `ref`.",
      "items": {
        "type": "object",
        "required": ["ref"],
        "additionalProperties": false,
        "properties": {
          "id": {"$ref": "common.schema.json#/$defs/id"},
          "item": {"$ref": "common.schema.json#/$defs/id", "description": "The thing's id: its name and icon label the choice."},
          "label": {"type": "string"},
          "when": {"type": "string"},
          "ref": {"type": "string"},
          "note": {"type": "string"}
        }
      }
    },
    "pockets": {
      "description": "F8: what a picked pocket holds beyond the coins their tags give: items [{id, qty}], or false for a pocket nobody can pick.",
      "oneOf": [
        {
          "type": "boolean"
        },
        {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "$ref": "common.schema.json#/$defs/id"
              },
              "qty": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      ]
    },
    "services": {
      "type": "array",
      "description": "F14: services this person sells on the services screen (story/services.gd defines each kind).",
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "enum": [
              "cure_wounds",
              "lesser_restoration",
              "remove_curse",
              "raise_dead",
              "room_modest",
              "room_wealthy"
            ]
          },
          "price": {
            "type": "number",
            "minimum": 0,
            "description": "Overrides the kind's price (for one hero, or each for a room)."
          },
          "scroll": {
            "type": "boolean",
            "description": "Read from the seller's scroll rather than cast."
          },
          "if": {
            "type": "string",
            "description": "A story condition; offered only while it holds."
          }
        }
      }
    }
  }
}
