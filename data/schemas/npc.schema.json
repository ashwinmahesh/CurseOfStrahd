{
  "$id": "npc.schema.json",
  "title": "Named NPC",
  "type": "object",
  "required": [
    "id",
    "name",
    "summary"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "name": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "portrait": {
      "type": "string"
    },
    "sprite": {
      "type": "string"
    },
    "attitude": {
      "type": "string",
      "enum": [
        "hostile",
        "indifferent",
        "friendly"
      ]
    },
    "voice": {
      "type": "string"
    },
    "monster": {
      "type": "string"
    },
    "guest": {
      "type": "boolean"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "region": {
      "type": "string"
    },
    "pronouns": {
      "type": "string"
    },
    "shop": {
      "type": "object",
      "required": [
        "sells"
      ],
      "additionalProperties": false,
      "properties": {
        "sells": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "$ref": "common.schema.json#/$defs/id"
              },
              "qty": {
                "type": "integer",
                "minimum": -1
              },
              "price": {
                "type": "number",
                "minimum": 0
              },
              "if": {
                "type": "string",
                "description": "A story condition; the line is for sale only while it holds."
              },
              "sets": {
                "$ref": "common.schema.json#/$defs/id",
                "description": "A flag set when the party buys one (Bildrath's one potion)."
              },
              "counts": {
                "$ref": "common.schema.json#/$defs/id",
                "description": "An int flag that counts the pieces bought (Morgantha's pastries)."
              }
            }
          }
        },
        "buys": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "markup": {
          "type": "number",
          "minimum": 0
        },
        "sell_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "closed": {
          "type": "string"
        },
        "haggle": {
          "type": "object",
          "additionalProperties": false,
          "description": "U11: the Persuasion haggle (story/trade.gd). dc defaults to 15; won/lost name flags the shop's dialogue shares, and a lost flag makes a failure final.",
          "properties": {
            "dc": {
              "type": "integer",
              "minimum": 1,
              "maximum": 30
            },
            "won": {
              "$ref": "common.schema.json#/$defs/id"
            },
            "lost": {
              "$ref": "common.schema.json#/$defs/id"
            }
          }
        },
        "price_flags": {
          "type": "array",
          "description": "Price changes while a condition holds: buy is a factor on what the party pays, for wares whose shop price is at least min_price.",
          "items": {
            "type": "object",
            "required": [
              "if",
              "buy"
            ],
            "additionalProperties": false,
            "properties": {
              "if": {
                "type": "string"
              },
              "buy": {
                "type": "number",
                "minimum": 0
              },
              "min_price": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        },
        "rotating": {
          "type": "object",
          "required": [
            "pool"
          ],
          "additionalProperties": false,
          "description": "F14: stock that changes: count things from pool, one of each, picked again every days days.",
          "properties": {
            "pool": {
              "type": "array",
              "items": {
                "$ref": "common.schema.json#/$defs/id"
              },
              "minItems": 1
            },
            "count": {
              "type": "integer",
              "minimum": 1
            },
            "days": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "guest_build": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "monster": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "pregen": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "level": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "note": {
          "type": "string"
        }
      }
    },
    "pockets": {
      "description": "F8: what a picked pocket holds beyond the coins their tags give: items [{id, qty}], or false for a pocket nobody can pick.",
      "oneOf": [
        {
          "type": "boolean"
        },
        {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "$ref": "common.schema.json#/$defs/id"
              },
              "qty": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      ]
    },
    "services": {
      "type": "array",
      "description": "F14: services this person sells on the services screen (story/services.gd defines each kind).",
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "enum": [
              "cure_wounds",
              "lesser_restoration",
              "remove_curse",
              "raise_dead",
              "room_modest",
              "room_wealthy"
            ]
          },
          "price": {
            "type": "number",
            "minimum": 0,
            "description": "Overrides the kind's price (for one hero, or each for a room)."
          },
          "scroll": {
            "type": "boolean",
            "description": "Read from the seller's scroll rather than cast."
          },
          "if": {
            "type": "string",
            "description": "A story condition; offered only while it holds."
          }
        }
      }
    }
  }
}
