{
  "$id": "quest.schema.json",
  "title": "Quest with stages for the journal",
  "type": "object",
  "required": [
    "id",
    "name",
    "summary",
    "stages"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "name": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "giver": {
      "type": "string"
    },
    "region": {
      "type": "string"
    },
    "kind": {
      "enum": [
        "main",
        "side"
      ],
      "description": "main: the story's spine, under the journal's Main tab. Anything else (side and companion quests) is under Other."
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "journal"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "journal": {
            "type": "string"
          },
          "objectives": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "hint": {
            "type": "string",
            "description": "What to do next at this stage, for the journal's Hint button: the place and the person or action, never the twist. Every stage that doesn't end the quest has one (make validate)."
          },
          "ends": {
            "type": "string",
            "enum": [
              "",
              "success",
              "failure"
            ]
          }
        }
      }
    }
  }
}
