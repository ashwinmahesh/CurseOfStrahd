{
  "$id": "monster.schema.json",
  "title": "Monster stat block (2024 format)",
  "type": "object",
  "required": ["id", "name", "source", "size", "type", "ac", "hp", "speed", "abilities", "cr", "actions"],
  "additionalProperties": false,
  "properties": {
    "id": {"$ref": "common.schema.json#/$defs/id"},
    "name": {"type": "string"},
    "source": {"$ref": "common.schema.json#/$defs/source"},
    "size": {"$ref": "common.schema.json#/$defs/size"},
    "type": {"type": "string", "enum": ["aberration", "beast", "celestial", "construct", "dragon", "elemental", "fey", "fiend", "giant", "humanoid", "monstrosity", "ooze", "plant", "undead"]},
    "tags": {"type": "array", "items": {"type": "string"}},
    "alignment": {"type": "string"},
    "ac": {"type": "integer", "minimum": 1},
    "initiative": {"type": "integer"},
    "hp": {"type": "object", "required": ["average", "dice"], "properties": {"average": {"type": "integer", "minimum": 1}, "dice": {"$ref": "common.schema.json#/$defs/dice"}}},
    "speed": {"type": "object", "properties": {"walk": {"type": "integer"}, "climb": {"type": "integer"}, "fly": {"type": "integer"}, "swim": {"type": "integer"}, "burrow": {"type": "integer"}, "hover": {"type": "boolean"}}},
    "abilities": {"type": "object", "required": ["str", "dex", "con", "int", "wis", "cha"], "properties": {"str": {"type": "integer"}, "dex": {"type": "integer"}, "con": {"type": "integer"}, "int": {"type": "integer"}, "wis": {"type": "integer"}, "cha": {"type": "integer"}}},
    "saves": {"type": "object"},
    "skills": {"type": "object"},
    "resistances": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/damage_type"}},
    "vulnerabilities": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/damage_type"}},
    "immunities": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/damage_type"}},
    "condition_immunities": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/condition"}},
    "senses": {"type": "object"},
    "passive_perception": {"type": "integer"},
    "languages": {"type": "array", "items": {"type": "string"}},
    "cr": {"type": "number", "minimum": 0, "maximum": 30},
    "traits": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/feature"}},
    "actions": {"type": "array", "items": {"type": "object", "required": ["id", "name"], "properties": {"id": {"$ref": "common.schema.json#/$defs/id"}, "name": {"type": "string"}, "attack": {"type": "object"}, "save": {"type": "object"}, "damage": {"type": "array"}, "recharge": {"type": "string"}, "summary": {"type": "string"}}}},
    "bonus_actions": {"type": "array"},
    "reactions": {"type": "array"},
    "legendary_actions": {"type": "object"},
    "lair_actions": {"type": "array"},
    "ai_profile": {"type": "string", "enum": ["brute", "cowardly", "pack_hunter", "spellcaster", "skirmisher", "strahd"]}
  }
}
