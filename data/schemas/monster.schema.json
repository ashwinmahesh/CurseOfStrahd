{
  "$id": "monster.schema.json",
  "title": "Monster stat block (2024 format)",
  "type": "object",
  "required": [
    "id",
    "name",
    "source",
    "size",
    "type",
    "ac",
    "hp",
    "speed",
    "abilities",
    "cr",
    "actions"
  ],
  "additionalProperties": false,
  "$defs": {
    "action": {
      "type": "object",
      "required": [
        "id",
        "name",
        "summary"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "name": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "melee",
            "ranged",
            "melee_or_ranged",
            "save",
            "multiattack",
            "spellcasting",
            "special"
          ]
        },
        "attack": {
          "type": "object",
          "required": [
            "bonus"
          ],
          "additionalProperties": false,
          "properties": {
            "bonus": {
              "type": "integer"
            },
            "reach": {
              "type": "integer"
            },
            "range": {
              "type": "array",
              "items": {
                "type": "integer"
              },
              "minItems": 1,
              "maxItems": 2
            }
          }
        },
        "save": {
          "type": "object",
          "required": [
            "ability",
            "dc"
          ],
          "additionalProperties": false,
          "properties": {
            "ability": {
              "$ref": "common.schema.json#/$defs/ability"
            },
            "dc": {
              "type": "integer"
            },
            "success": {
              "type": "string",
              "enum": [
                "half",
                "none",
                "special"
              ]
            }
          }
        },
        "area": {
          "type": "object"
        },
        "damage": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "average",
              "dice",
              "type"
            ],
            "additionalProperties": false,
            "properties": {
              "average": {
                "type": "integer",
                "minimum": 0
              },
              "dice": {
                "$ref": "common.schema.json#/$defs/dice"
              },
              "type": {
                "$ref": "common.schema.json#/$defs/damage_type"
              },
              "when": {
                "type": "string",
                "description": "Extra damage only in some cases, e.g. two-handed, on a failed save, sunlight."
              },
              "if": {
                "type": "string",
                "enum": [
                  "bloodied",
                  "not_bloodied"
                ]
              }
            }
          }
        },
        "conditions": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/condition"
          }
        },
        "multiattack": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "action",
              "count"
            ],
            "additionalProperties": false,
            "properties": {
              "action": {
                "$ref": "common.schema.json#/$defs/id"
              },
              "count": {
                "type": "integer",
                "minimum": 1
              },
              "or": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "recharge": {
          "type": "string",
          "pattern": "^[1-6](-6)?$"
        },
        "uses": {
          "type": "object",
          "properties": {
            "count": {
              "type": "integer"
            },
            "per": {
              "type": "string",
              "enum": [
                "day",
                "short",
                "long",
                "turn"
              ]
            }
          }
        },
        "cost": {
          "type": "integer",
          "description": "Legendary action cost."
        },
        "trigger": {
          "type": "string"
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string"
        },
        "on_hit": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/rider"
          },
          "description": "What a hit does besides damage."
        },
        "on_fail": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/rider"
          },
          "description": "What a failed save does besides damage."
        },
        "targets": {
          "type": "object",
          "description": "Who a save action targets: range, count, max_size, in_space, types, not_types, requires (conditions, or willing). On an attack action, `requires` limits its targets too (a vampire's Bite: grappled, incapacitated or restrained)."
        },
        "weapon": {
          "type": "boolean",
          "description": "A weapon the creature holds (it can be disarmed)."
        },
        "forms": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Shape-Shift forms in which the action can be used."
        },
        "do": {
          "type": "string",
          "enum": [
            "dash_or_disengage",
            "hide_in_dim",
            "shape_shift",
            "cast",
            "swoop",
            "trample",
            "rampage",
            "consume_life",
            "vanish",
            "cast_control",
            "vow",
            "bonus_save"
          ],
          "description": "What a special bonus action does."
        },
        "cast": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Spells a spellcasting action can cast."
        },
        "ac_bonus": {
          "type": "integer",
          "description": "Parry: AC bonus against one melee hit."
        },
        "charge": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "feet"
          ],
          "description": "Extra effect when the monster moved at least `feet` straight toward the target right before the hit.",
          "properties": {
            "feet": {
              "type": "integer"
            },
            "replace": {
              "type": "boolean",
              "description": "The charge damage replaces the normal damage."
            },
            "damage": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "dice",
                  "type"
                ],
                "additionalProperties": false,
                "properties": {
                  "average": {
                    "type": "integer"
                  },
                  "dice": {
                    "$ref": "common.schema.json#/$defs/dice"
                  },
                  "type": {
                    "$ref": "common.schema.json#/$defs/damage_type"
                  }
                }
              }
            },
            "on_hit": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/rider"
              }
            }
          }
        },
        "immune_on_success": {
          "type": "boolean",
          "description": "save action: a creature that succeeds can't be affected by this monster's action again (24 hours)."
        },
        "dc": {
          "type": "integer",
          "description": "A bonus action's save DC when it has no `save` block (Consume Life)."
        },
        "summon": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "choices"
          ],
          "description": "Calls creatures into the fight (Children of the Night): one of `choices` (the first allowed where the fight is), arriving after `arrive` rounds.",
          "properties": {
            "choices": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "monster",
                  "count"
                ],
                "properties": {
                  "monster": {
                    "$ref": "common.schema.json#/$defs/id"
                  },
                  "count": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": 1
                      },
                      {
                        "$ref": "common.schema.json#/$defs/dice"
                      }
                    ]
                  },
                  "max": {
                    "type": "integer",
                    "minimum": 1,
                    "description": "At most this many, whatever the dice say."
                  },
                  "where": {
                    "type": "string",
                    "enum": [
                      "any",
                      "outdoors",
                      "indoors"
                    ]
                  }
                }
              }
            },
            "arrive": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "$ref": "common.schema.json#/$defs/dice"
                }
              ],
              "description": "Rounds until they arrive (0: at once)."
            },
            "not_in": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "sunlight",
                  "running_water"
                ]
              }
            }
          }
        },
        "drop_at_hp": {
          "type": "integer",
          "description": "save action: a creature that fails with this many Hit Points or fewer (before the damage) drops to 0 (Deathly Wail)."
        },
        "not_while_grappling": {
          "type": "boolean",
          "description": "Can't be used while the monster holds a creature (a vine blight's Constricting Vine)."
        },
        "magical": {
          "type": "boolean",
          "description": "A magical ability: enables defenses against magical effects on its save and damage."
        }
      }
    },
    "rider": {
      "type": "object",
      "required": [
        "do"
      ],
      "additionalProperties": false,
      "description": "A machine-readable rider (combat/monster_actions.gd).",
      "properties": {
        "do": {
          "type": "string",
          "enum": [
            "condition",
            "grapple",
            "pull",
            "push",
            "drain_max_hp",
            "heal_self",
            "ability_drain",
            "curse",
            "engulf",
            "burning",
            "possess"
          ]
        },
        "condition": {
          "$ref": "common.schema.json#/$defs/condition"
        },
        "conditions": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/condition"
          }
        },
        "save": {
          "type": "object"
        },
        "until": {
          "type": "string",
          "enum": [
            "target_turn_end",
            "target_turn_start",
            "source_turn_start",
            "source_turn_end",
            "minute",
            "permanent"
          ]
        },
        "not_types": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "only_types": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "not_species": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "max_size": {
          "$ref": "common.schema.json#/$defs/size"
        },
        "escape_dc": {
          "type": "integer"
        },
        "limit": {
          "type": "integer"
        },
        "feet": {
          "type": "integer"
        },
        "type": {
          "$ref": "common.schema.json#/$defs/damage_type"
        },
        "ability": {
          "$ref": "common.schema.json#/$defs/ability"
        },
        "dice": {
          "$ref": "common.schema.json#/$defs/dice"
        },
        "curse": {
          "type": "string"
        },
        "immune_on_success": {
          "type": "boolean"
        },
        "damage": {
          "type": "object"
        },
        "modifiers": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/modifier"
          }
        },
        "restrain": {
          "type": "boolean",
          "description": "grapple: the target is also Restrained until the grapple ends."
        },
        "escape": {
          "type": "object",
          "required": [
            "skill",
            "dc"
          ],
          "additionalProperties": false,
          "properties": {
            "skill": {
              "type": "string"
            },
            "dc": {
              "type": "integer"
            }
          },
          "description": "condition: an action and this check ends it."
        },
        "object": {
          "type": "string",
          "description": "condition: it lasts until this object (a kind in data/objects/kinds.json, placed round the target) is destroyed: a giant spider's web."
        },
        "hold_damage": {
          "type": "object",
          "required": [
            "dice",
            "type"
          ],
          "additionalProperties": false,
          "properties": {
            "dice": {
              "$ref": "common.schema.json#/$defs/dice"
            },
            "type": {
              "$ref": "common.schema.json#/$defs/damage_type"
            }
          },
          "description": "grapple: damage to the held creature at the start of each of the grappler's turns."
        },
        "repeat_save": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ability",
            "dc"
          ],
          "description": "condition: the target repeats the save to end it (`when`: end or start of its turns, or manual), and each time it takes damage when `on_damage` (Strahd's Charm).",
          "properties": {
            "ability": {
              "$ref": "common.schema.json#/$defs/ability"
            },
            "dc": {
              "type": "integer"
            },
            "when": {
              "type": "string",
              "enum": [
                "end",
                "start",
                "manual"
              ]
            },
            "on_damage": {
              "type": "boolean"
            },
            "bind_after": {
              "type": "integer",
              "description": "After this many failed saves the effect can't be shaken off (an arcanaloth's Soul Tome)."
            }
          }
        },
        "also_if_vowed": {
          "$ref": "common.schema.json#/$defs/condition",
          "description": "condition: a second condition when the target is the monster's sworn foe (Vow of Revenge)."
        },
        "grip_damage": {
          "type": "object",
          "required": [
            "dice",
            "type"
          ],
          "additionalProperties": false,
          "properties": {
            "dice": {
              "$ref": "common.schema.json#/$defs/dice"
            },
            "type": {
              "$ref": "common.schema.json#/$defs/damage_type"
            }
          },
          "description": "grapple: damage to the held creature at the start of each of its own turns."
        }
      }
    },
    "form": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "size",
        "speed"
      ],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "name": {
          "type": "string"
        },
        "size": {
          "$ref": "common.schema.json#/$defs/size"
        },
        "speed": {
          "$ref": "#/properties/speed"
        },
        "actions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Action ids usable in this shape; [] = none (it can't attack or cast)."
        },
        "immunities": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/damage_type"
          }
        },
        "resistances": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/damage_type"
          }
        },
        "vulnerabilities": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/damage_type"
          }
        },
        "condition_immunities": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/condition"
          }
        },
        "save_advantage": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/ability"
          }
        },
        "flags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Flags while in this shape (enters_spaces, pass_through_creatures, spider_climb...)."
        },
        "art": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$",
          "description": "Sprite id for this shape (art/sprites/<art>/)."
        },
        "summary": {
          "type": "string"
        }
      }
    },
    "lair_action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "summary",
        "kind"
      ],
      "description": "self: modifiers on the lair's master until the next lair turn; attack: an attack roll at a foe it can see; save: foes in range save (damage, riders, a summon on a failure); summon: creatures appear; text: told only.",
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "name": {
          "type": "string"
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "self",
            "attack",
            "save",
            "summon",
            "text"
          ]
        },
        "modifiers": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/modifier"
          }
        },
        "attack": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "bonus"
          ],
          "properties": {
            "bonus": {
              "type": "integer"
            },
            "range": {
              "type": "integer"
            }
          }
        },
        "damage": {
          "$ref": "#/$defs/action/properties/damage"
        },
        "on_hit": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/rider"
          }
        },
        "save": {
          "$ref": "#/$defs/action/properties/save"
        },
        "targets": {
          "type": "object",
          "description": "range (from the master, default 120), count (default 1), max_size, types, not_types."
        },
        "on_fail": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/rider"
          }
        },
        "summon": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "monster"
          ],
          "properties": {
            "monster": {
              "$ref": "common.schema.json#/$defs/id"
            },
            "count": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 1
                },
                {
                  "$ref": "common.schema.json#/$defs/dice"
                }
              ]
            },
            "max": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    }
  },
  "properties": {
    "id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "name": {
      "type": "string"
    },
    "source": {
      "$ref": "common.schema.json#/$defs/source"
    },
    "size": {
      "$ref": "common.schema.json#/$defs/size"
    },
    "type": {
      "type": "string",
      "enum": [
        "aberration",
        "beast",
        "celestial",
        "construct",
        "dragon",
        "elemental",
        "fey",
        "fiend",
        "giant",
        "humanoid",
        "monstrosity",
        "ooze",
        "plant",
        "undead"
      ]
    },
    "swarm_of": {
      "$ref": "common.schema.json#/$defs/size",
      "description": "For swarms: the size of the individual creatures."
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "alignment": {
      "type": "string"
    },
    "ac": {
      "type": "integer",
      "minimum": 1
    },
    "ac_note": {
      "type": "string"
    },
    "initiative": {
      "type": "integer",
      "description": "Initiative modifier as printed (the stat block also prints the passive score = 10 + this)."
    },
    "hp": {
      "type": "object",
      "required": [
        "average",
        "dice"
      ],
      "additionalProperties": false,
      "properties": {
        "average": {
          "type": "integer",
          "minimum": 1
        },
        "dice": {
          "$ref": "common.schema.json#/$defs/dice"
        }
      }
    },
    "speed": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "walk": {
          "type": "integer"
        },
        "climb": {
          "type": "integer"
        },
        "fly": {
          "type": "integer"
        },
        "swim": {
          "type": "integer"
        },
        "burrow": {
          "type": "integer"
        },
        "hover": {
          "type": "boolean"
        }
      }
    },
    "abilities": {
      "type": "object",
      "required": [
        "str",
        "dex",
        "con",
        "int",
        "wis",
        "cha"
      ],
      "additionalProperties": false,
      "properties": {
        "str": {
          "type": "integer"
        },
        "dex": {
          "type": "integer"
        },
        "con": {
          "type": "integer"
        },
        "int": {
          "type": "integer"
        },
        "wis": {
          "type": "integer"
        },
        "cha": {
          "type": "integer"
        }
      }
    },
    "saves": {
      "type": "object",
      "description": "Ability -> total save bonus, only where it differs from the plain modifier.",
      "additionalProperties": {
        "type": "integer"
      }
    },
    "skills": {
      "type": "object",
      "description": "Skill -> total bonus.",
      "additionalProperties": {
        "type": "integer"
      }
    },
    "resistances": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/damage_type"
      }
    },
    "vulnerabilities": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/damage_type"
      }
    },
    "immunities": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/damage_type"
      }
    },
    "condition_immunities": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/condition"
      }
    },
    "senses": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "darkvision": {
          "type": "integer"
        },
        "blindsight": {
          "type": "integer"
        },
        "tremorsense": {
          "type": "integer"
        },
        "truesight": {
          "type": "integer"
        }
      }
    },
    "passive_perception": {
      "type": "integer"
    },
    "languages": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "telepathy": {
      "type": "integer"
    },
    "cr": {
      "type": "number",
      "minimum": 0,
      "maximum": 30
    },
    "xp": {
      "type": "integer",
      "minimum": 0
    },
    "proficiency_bonus": {
      "type": "integer"
    },
    "gear": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "traits": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/feature"
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/action"
      }
    },
    "bonus_actions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/action"
      }
    },
    "reactions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/action"
      }
    },
    "legendary_actions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "per_round",
        "options"
      ],
      "description": "ADR 0014: `per_round` actions, spent at the end of another creature's turn and refreshed at the start of the monster's own (combat/legendary.gd).",
      "properties": {
        "per_round": {
          "type": "integer",
          "minimum": 1
        },
        "options": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "name",
              "summary"
            ],
            "properties": {
              "id": {
                "$ref": "common.schema.json#/$defs/id"
              },
              "name": {
                "type": "string"
              },
              "cost": {
                "type": "integer",
                "minimum": 1,
                "description": "Legendary actions it spends (default 1)."
              },
              "action": {
                "$ref": "common.schema.json#/$defs/id",
                "description": "One use of this stat-block action (an attack or a save action)."
              },
              "move": {
                "type": "boolean",
                "description": "Moves up to its Speed without provoking Opportunity Attacks."
              },
              "summary": {
                "type": "string",
                "minLength": 1
              },
              "text": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "lair_actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/lair_action"
      },
      "description": "ADR 0014: one on initiative count 20 (losing ties) each round when the encounter has `lair: true`; never the same one twice in a row."
    },
    "spellcasting": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ability": {
          "$ref": "common.schema.json#/$defs/ability"
        },
        "dc": {
          "type": "integer"
        },
        "attack": {
          "type": "integer"
        },
        "at_will": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "per_day": {
          "type": "object",
          "description": "\"1\", \"2\", \"3\" -> spell ids usable that many times a day each.",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "levels": {
          "type": "object",
          "description": "spell id -> the level it is cast at (Wall of Fire at 7th for the efreeti).",
          "additionalProperties": {
            "type": "integer"
          }
        }
      }
    },
    "regions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Where the game uses it, e.g. death_house, village_of_barovia."
    },
    "ai_profile": {
      "type": "string",
      "enum": [
        "brute",
        "cowardly",
        "pack_hunter",
        "spellcaster",
        "skirmisher",
        "swarm",
        "mindless",
        "support",
        "strahd"
      ]
    },
    "summary": {
      "type": "string"
    },
    "art": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$",
      "description": "Sprite and portrait id when it isn't the block's own id (art/sprites/<art>/), e.g. a named NPC's block."
    },
    "art_height": {
      "type": "number",
      "minimum": 0.5,
      "maximum": 8,
      "description": "Sprite height in world units when the block borrows a smaller creature's sprite at a bigger size (CombatToken.height_of); unset, the art id's own height (CombatToken.HEIGHTS)."
    },
    "legendary_resistance": {
      "type": "integer",
      "minimum": 1,
      "description": "Legendary Resistance uses per day (per fight in the game): a failed save becomes a success."
    },
    "regenerates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hp"
      ],
      "description": "Regeneration for any monster: `hp` back at the start of its turn while it has at least 1 Hit Point; taking any `stopped_by` damage type stops it at the start of its next turn; `running_water` / `sunlight` true: it doesn't work while the creature is there.",
      "properties": {
        "hp": {
          "type": "integer",
          "minimum": 1
        },
        "stopped_by": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/damage_type"
          }
        },
        "running_water": {
          "type": "boolean"
        },
        "sunlight": {
          "type": "boolean"
        }
      }
    },
    "forms": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "shapes"
      ],
      "description": "Shapechanger: shapes it can take (each swaps size, speeds, usable actions and defenses and keeps its Hit Points). Actions' own `forms` lists name `base` for its true form.",
      "properties": {
        "base": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$",
          "description": "The true form's name (default humanoid)."
        },
        "change": {
          "type": "string",
          "enum": [
            "action",
            "bonus_action"
          ],
          "description": "What changing shape costs (default action)."
        },
        "blocked_in": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "sunlight",
              "running_water"
            ]
          }
        },
        "shapes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/form"
          }
        }
      }
    },
    "misty_escape": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resting_place",
        "flag"
      ],
      "description": "ADR 0014: dropping to 0 Hit Points anywhere but `resting_place` (a location id) turns it to mist and it leaves the fight, setting `flag`; there it is destroyed (`destroyed_flag`, `quest` stage). Sunlight or running water (`blocked_in`) destroy it outright.",
      "properties": {
        "resting_place": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "flag": {
          "type": "string"
        },
        "form": {
          "type": "string",
          "description": "The shape it flees in (default mist)."
        },
        "destroyed_flag": {
          "type": "string"
        },
        "quest": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "stage"
          ],
          "properties": {
            "id": {
              "$ref": "common.schema.json#/$defs/id"
            },
            "stage": {
              "$ref": "common.schema.json#/$defs/id"
            }
          }
        },
        "blocked_in": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "sunlight",
              "running_water"
            ]
          }
        },
        "narration": {
          "type": "string",
          "description": "Narrator key played as it flees (narrative/narrator/*.dialogue), telling the party where it went."
        }
      }
    },
    "ward": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hp"
      ],
      "description": "A ward of `hp` taken before its Hit Points in a fight (the Heart of Sorrow shielding Strahd), unless the story condition `unless` holds; only in locations of `region` when given.",
      "properties": {
        "hp": {
          "type": "integer",
          "minimum": 1
        },
        "unless": {
          "type": "string"
        },
        "region": {
          "$ref": "common.schema.json#/$defs/id"
        }
      }
    }
  }
}
