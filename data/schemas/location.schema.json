{
  "$id": "location.schema.json",
  "title": "Location: an explorable grid map (ADR 0009, docs/contracts/locations.md)",
  "type": "object",
  "required": [
    "id",
    "name",
    "region",
    "summary",
    "map"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "name": {
      "type": "string"
    },
    "region": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "watch": {
      "type": "string",
      "description": "F8: the guard who answers a crime here (an npc id), or \"\" for nobody. Unset: the region's watch (story/crime.gd WATCH)."
    },
    "summary": {
      "type": "string"
    },
    "text": {
      "type": "string"
    },
    "map": {
      "type": "object",
      "required": [
        "rows"
      ],
      "additionalProperties": false,
      "properties": {
        "rows": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[.#=~w 1-4]+$"
          }
        },
        "ceiling_ft": {
          "type": "integer",
          "minimum": 10,
          "description": "The ceiling's height in feet, which flyers can't rise above. Default: 20 indoors, the open sky outdoors."
        },
        "drop_ft": {
          "type": "integer",
          "minimum": 10,
          "description": "How far the open void beside the floor falls (a chasm, a tower's well): a creature forced over the edge falls this far and out of the fight. Without it, the void is the map's edge and nothing crosses it."
        },
        "theme": {
          "type": "string"
        },
        "light": {
          "type": "string",
          "enum": [
            "bright",
            "dim",
            "dark"
          ]
        },
        "outdoors": {
          "type": "boolean"
        }
      }
    },
    "areas": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "cells"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "name": {
            "type": "string"
          },
          "cells": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "$ref": "#/$defs/cell"
            },
            "description": "Two corners of a rectangle, inclusive."
          },
          "light": {
            "type": "string",
            "enum": [
              "bright",
              "dim",
              "dark"
            ]
          },
          "floor": {
            "type": "string",
            "pattern": "^[a-z_]+/[a-z_]+$",
            "description": "The room's floor: a texture surface, theme/surface in art/textures/manifest.json (docs/art/set_dressing.md). Optional; otherwise the catalog's room rules or the map's theme decide."
          },
          "walls": {
            "type": "string",
            "pattern": "^[a-z_]+/[a-z_]+$",
            "description": "The room's walls: a texture surface, theme/surface in art/textures/manifest.json. Optional."
          },
          "private": {
            "$ref": "common.schema.json#/$defs/id",
            "description": "F8: the npc whose private room this is. Seen inside, the party is told to leave; seen again, it's trespass."
          },
          "open": {
            "type": "string",
            "description": "F8: when a private room may be entered (a condition, docs/contracts/dialogue.md), e.g. \"day\"."
          }
        }
      }
    },
    "spawns": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/cell"
      }
    },
    "exits": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "cell",
          "to"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "cell": {
            "$ref": "#/$defs/cell"
          },
          "to": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "spawn": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "when": {
            "type": "string"
          },
          "locked_text": {
            "type": "string"
          }
        }
      }
    },
    "doors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "cell"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "cell": {
            "$ref": "#/$defs/cell"
          },
          "locked": {
            "type": "boolean"
          },
          "lock_dc": {
            "type": "integer",
            "minimum": 0
          },
          "key": {
            "type": "string"
          },
          "secret_dc": {
            "type": "integer",
            "minimum": 0
          },
          "label": {
            "type": "string"
          },
          "when": {
            "type": "string"
          },
          "flag": {
            "type": "string"
          }
        }
      }
    },
    "props": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "cell",
          "kind"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "cell": {
            "$ref": "#/$defs/cell"
          },
          "kind": {
            "type": "string",
            "enum": [
              "examine",
              "book",
              "search",
              "lever",
              "decor"
            ]
          },
          "label": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "when": {
            "type": "string"
          },
          "dialogue": {
            "type": "string"
          },
          "item": {
            "type": "string"
          },
          "flag": {
            "type": "string"
          },
          "search_dc": {
            "type": "integer"
          },
          "skill": {
            "type": "string",
            "enum": ["perception", "investigation"],
            "description": "A search prop: the check that finds it (default perception; investigation for a compartment you work out). A search prop holding an item gets one try per character."
          },
          "codex": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "burning": {
            "type": "string",
            "description": "A condition: while it holds, the prop burns (a big flame and light)."
          },
          "hangs": {
            "type": "object",
            "description": "A chandelier hanging over `cells` (its piece is drawn up there): in a fight its chain can be broken to drop it on whoever is below (data/objects/kinds.json chandelier; world/combat/battle_scenery.gd). `trap`: the location trap that is this chandelier falling (sprung, it's down); `flag`: set once it has fallen (the prop's `when` reads it).",
            "required": ["cells"],
            "additionalProperties": false,
            "properties": {
              "cells": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/cell"}},
              "kind": {"type": "string", "description": "Its kind in data/objects/kinds.json (chandelier by default)."},
              "trap": {"type": "string"},
              "flag": {"type": "string"},
              "lit": {"type": "boolean", "description": "Its candles burn: falling, it sets oil under it alight."}
            }
          }
        }
      }
    },
    "containers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "cell"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "cell": {
            "$ref": "#/$defs/cell"
          },
          "label": {
            "type": "string"
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id"
              ],
              "additionalProperties": false,
              "properties": {
                "id": {
                  "$ref": "common.schema.json#/$defs/id"
                },
                "qty": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          },
          "gold": {
            "type": "number",
            "minimum": 0
          },
          "lock_dc": {
            "type": "integer",
            "minimum": 0
          },
          "key": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "when": {
            "type": "string"
          },
          "flag": {
            "type": "string"
          },
          "owner": {
            "$ref": "common.schema.json#/$defs/id",
            "description": "F8: the npc who owns it. Taking anything from it is stealing if somebody sees (docs/rules/stealth.md)."
          }
        }
      }
    },
    "lights": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "cell",
          "kind"
        ],
        "additionalProperties": false,
        "properties": {
          "cell": {
            "$ref": "#/$defs/cell"
          },
          "kind": {
            "type": "string",
            "enum": [
              "candle",
              "torch",
              "lamp",
              "fire",
              "window",
              "magic"
            ]
          },
          "bright_ft": {
            "type": "integer",
            "minimum": 0
          },
          "dim_ft": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "traps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "cells",
          "detect_dc"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "cells": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/cell"
            }
          },
          "label": {
            "type": "string"
          },
          "detect_dc": {
            "type": "integer"
          },
          "disarm_dc": {
            "type": "integer"
          },
          "save": {
            "type": "object",
            "required": [
              "ability",
              "dc"
            ],
            "properties": {
              "ability": {
                "$ref": "common.schema.json#/$defs/ability"
              },
              "dc": {
                "type": "integer"
              }
            },
            "additionalProperties": false
          },
          "damage": {
            "type": "string"
          },
          "damage_type": {
            "$ref": "common.schema.json#/$defs/damage_type"
          },
          "condition": {
            "$ref": "common.schema.json#/$defs/condition"
          },
          "flag": {
            "type": "string"
          },
          "when": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "pit_ft": {
            "description": "A pit this many feet deep: shown as a hole once found or sprung; a failed save drops the victim in (falling damage plus the trap's), and they climb out with rope or a DC 15 Athletics check (world/exploration/pit_fall.gd).",
            "type": "integer",
            "minimum": 0
          },
          "model": {
            "description": "The prop art a noticed trap shows (art/sprites/props); else picked by a word in its id or label (world/exploration/trap_sight.gd).",
            "type": "string"
          }
        }
      }
    },
    "npcs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "npc",
          "cell"
        ],
        "additionalProperties": false,
        "properties": {
          "npc": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "cell": {
            "$ref": "#/$defs/cell"
          },
          "dialogue": {
            "type": "string"
          },
          "when": {
            "type": "string"
          },
          "facing": {
            "type": "string",
            "enum": ["north", "south", "east", "west", "northeast", "northwest", "southeast", "southwest"],
            "description": "Which way the NPC looks while standing (north is up the map)."
          },
          "approach": {
            "type": "integer",
            "minimum": 1,
            "maximum": 12,
            "description": "Squares: the NPC starts its dialogue once when the leader comes this close and can see them."
          },
          "asleep": {
            "type": "boolean",
            "description": "The NPC lies asleep here: Unconscious (so Incapacitated and Prone), drawn lying down, and the hover hint, Look and the Alt plates say so."
          },
          "path": {
            "type": "array",
            "minItems": 1,
            "description": "Waypoints the NPC walks from its cell, in order and back again: [x, y] or [x, y, seconds to stand there].",
            "items": {
              "type": "array",
              "minItems": 2,
              "maxItems": 3,
              "items": {
                "type": "number",
                "minimum": 0
              }
            }
          },
          "pause": {
            "type": "number",
            "minimum": 0,
            "description": "Seconds the NPC stands at each waypoint of its path (default 3)."
          },
          "hours": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "number",
              "minimum": 0,
              "maximum": 24
            },
            "description": "[from, to]: the NPC is here only between these hours (to may be past midnight, [19, 6]); with `when`, both must hold."
          }
        }
      }
    },
    "encounters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "trigger",
          "monsters"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "trigger": {
            "type": "string"
          },
          "when": {
            "type": "string"
          },
          "monsters": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "monster",
                "cell"
              ],
              "additionalProperties": false,
              "properties": {
                "monster": {
                  "$ref": "common.schema.json#/$defs/id"
                },
                "cell": {
                  "$ref": "#/$defs/cell"
                },
                "name": {
                  "type": "string"
                },
                "side": {
                  "type": "string",
                  "enum": [
                    "enemy",
                    "neutral"
                  ]
                },
                "hp": {
                  "type": "integer",
                  "minimum": 1,
                  "description": "Overrides the stat block's Hit Points for this fight."
                },
                "facing": {
                  "type": "string",
                  "enum": [
                    "north",
                    "south",
                    "east",
                    "west",
                    "northeast",
                    "northwest",
                    "southeast",
                    "southwest"
                  ],
                  "description": "F7: which way this foe faces while it waits in plain view before its fight (its sight cone points there). Unset: toward the middle of its group, else of its fight's area."
                }
              }
            }
          },
          "waiting": {
            "type": "boolean",
            "description": "F7: the foes stand in plain view before the fight (enter_area triggers only): they show once the party can see them, can notice the party, and can be attacked first (docs/rules/stealth.md)."
          },
          "surprise": {
            "type": "string",
            "enum": [
              "",
              "party",
              "enemies"
            ]
          },
          "flag": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "quest": {
            "type": "object",
            "required": [
              "id",
              "stage"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "$ref": "common.schema.json#/$defs/id"
              },
              "stage": {
                "$ref": "common.schema.json#/$defs/id"
              }
            },
            "description": "Quest stage reached on victory."
          },
          "loot": {
            "type": "object",
            "additionalProperties": false,
            "description": "What the fight leaves when won (a loot window).",
            "properties": {
              "gold": {
                "type": "number",
                "minimum": 0
              },
              "items": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "id"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "qty": {
                      "type": "integer",
                      "minimum": 1
                    }
                  }
                }
              }
            }
          },
          "final_battle": {
            "$ref": "common.schema.json#/$defs/id",
            "description": "ADR 0014: this is Strahd's fight in this Tarokka enemy room; the engine adds final_room:<room>, strahds_lair at foretold or later and not destroyed to `when`, and plays strahd/final:parley first."
          },
          "lair": {
            "type": "boolean",
            "description": "Lair actions on initiative count 20 for a monster that has them."
          },
          "withdraw": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "who",
              "flag"
            ],
            "description": "A foe leaves the fight (no loot, no death) below `at_hp_below` Hit Points or after `after_rounds` rounds, setting `flag`.",
            "properties": {
              "who": {
                "$ref": "common.schema.json#/$defs/id"
              },
              "at_hp_below": {
                "type": "integer",
                "minimum": 1
              },
              "after_rounds": {
                "type": "integer",
                "minimum": 1
              },
              "flag": {
                "type": "string"
              }
            }
          },
          "allies_block": {
            "type": "boolean",
            "description": "In this fight, party members can't move through each other's spaces (default: they can, as Difficult Terrain)."
          }
        }
      }
    },
    "narration": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "rest": {
      "type": "string",
      "enum": [
        "safe",
        "risky",
        "no"
      ],
      "description": "Whether a Long Rest is possible here (risky: 1 in 6 to be interrupted)."
    },
    "rest_text": {
      "type": "string",
      "description": "Why resting isn't possible (shown when rest is 'no')."
    },
    "treasure_spots": {
      "description": "Tarokka places this location holds (ADR 0011): place id (data/tarokka/outcomes.json) -> the container, fight or conversation where the treasure the reading put there is found.",
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "minProperties": 1,
        "maxProperties": 1,
        "properties": {
          "container": {
            "type": "string"
          },
          "encounter": {
            "type": "string"
          },
          "dialogue": {
            "type": "string"
          }
        }
      }
    },
    "allies_block": {
      "type": "boolean",
      "description": "Party members can't move through each other's spaces anywhere in this location."
    }
  },
  "$defs": {
    "cell": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "integer",
        "minimum": 0
      }
    }
  }
}
