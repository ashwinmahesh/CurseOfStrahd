{
  "$id": "location.schema.json",
  "title": "Location: an explorable grid map (ADR 0009, docs/contracts/locations.md)",
  "type": "object",
  "required": [
    "id",
    "name",
    "region",
    "summary",
    "map"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "name": {
      "type": "string"
    },
    "region": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "summary": {
      "type": "string"
    },
    "text": {
      "type": "string"
    },
    "map": {
      "type": "object",
      "required": [
        "rows"
      ],
      "additionalProperties": false,
      "properties": {
        "rows": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[.#=~ 1-4]+$"
          }
        },
        "theme": {
          "type": "string"
        },
        "light": {
          "type": "string",
          "enum": [
            "bright",
            "dim",
            "dark"
          ]
        },
        "outdoors": {
          "type": "boolean"
        }
      }
    },
    "areas": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "cells"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "name": {
            "type": "string"
          },
          "cells": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "$ref": "#/$defs/cell"
            },
            "description": "Two corners of a rectangle, inclusive."
          },
          "light": {
            "type": "string",
            "enum": [
              "bright",
              "dim",
              "dark"
            ]
          }
        }
      }
    },
    "spawns": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/cell"
      }
    },
    "exits": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "cell",
          "to"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "cell": {
            "$ref": "#/$defs/cell"
          },
          "to": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "spawn": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "when": {
            "type": "string"
          },
          "locked_text": {
            "type": "string"
          }
        }
      }
    },
    "doors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "cell"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "cell": {
            "$ref": "#/$defs/cell"
          },
          "locked": {
            "type": "boolean"
          },
          "lock_dc": {
            "type": "integer",
            "minimum": 0
          },
          "key": {
            "type": "string"
          },
          "secret_dc": {
            "type": "integer",
            "minimum": 0
          },
          "label": {
            "type": "string"
          },
          "when": {
            "type": "string"
          },
          "flag": {
            "type": "string"
          }
        }
      }
    },
    "props": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "cell",
          "kind"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "cell": {
            "$ref": "#/$defs/cell"
          },
          "kind": {
            "type": "string",
            "enum": [
              "examine",
              "book",
              "search",
              "lever",
              "decor"
            ]
          },
          "label": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "when": {
            "type": "string"
          },
          "dialogue": {
            "type": "string"
          },
          "item": {
            "type": "string"
          },
          "flag": {
            "type": "string"
          },
          "search_dc": {
            "type": "integer"
          },
          "codex": {
            "type": "string"
          },
          "text": {
            "type": "string"
          }
        }
      }
    },
    "containers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "cell"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "cell": {
            "$ref": "#/$defs/cell"
          },
          "label": {
            "type": "string"
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id"
              ],
              "additionalProperties": false,
              "properties": {
                "id": {
                  "$ref": "common.schema.json#/$defs/id"
                },
                "qty": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          },
          "gold": {
            "type": "number",
            "minimum": 0
          },
          "lock_dc": {
            "type": "integer",
            "minimum": 0
          },
          "key": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "when": {
            "type": "string"
          },
          "flag": {
            "type": "string"
          }
        }
      }
    },
    "lights": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "cell",
          "kind"
        ],
        "additionalProperties": false,
        "properties": {
          "cell": {
            "$ref": "#/$defs/cell"
          },
          "kind": {
            "type": "string",
            "enum": [
              "candle",
              "torch",
              "lamp",
              "fire",
              "window",
              "magic"
            ]
          },
          "bright_ft": {
            "type": "integer",
            "minimum": 0
          },
          "dim_ft": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "traps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "cells",
          "detect_dc"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "cells": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/cell"
            }
          },
          "label": {
            "type": "string"
          },
          "detect_dc": {
            "type": "integer"
          },
          "disarm_dc": {
            "type": "integer"
          },
          "save": {
            "type": "object",
            "required": [
              "ability",
              "dc"
            ],
            "properties": {
              "ability": {
                "$ref": "common.schema.json#/$defs/ability"
              },
              "dc": {
                "type": "integer"
              }
            },
            "additionalProperties": false
          },
          "damage": {
            "type": "string"
          },
          "damage_type": {
            "$ref": "common.schema.json#/$defs/damage_type"
          },
          "condition": {
            "$ref": "common.schema.json#/$defs/condition"
          },
          "flag": {
            "type": "string"
          },
          "when": {
            "type": "string"
          },
          "text": {
            "type": "string"
          }
        }
      }
    },
    "npcs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "npc",
          "cell"
        ],
        "additionalProperties": false,
        "properties": {
          "npc": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "cell": {
            "$ref": "#/$defs/cell"
          },
          "dialogue": {
            "type": "string"
          },
          "when": {
            "type": "string"
          },
          "facing": {
            "type": "string"
          }
        }
      }
    },
    "encounters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "trigger",
          "monsters"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "trigger": {
            "type": "string"
          },
          "when": {
            "type": "string"
          },
          "monsters": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "monster",
                "cell"
              ],
              "additionalProperties": false,
              "properties": {
                "monster": {
                  "$ref": "common.schema.json#/$defs/id"
                },
                "cell": {
                  "$ref": "#/$defs/cell"
                },
                "name": {
                  "type": "string"
                },
                "side": {
                  "type": "string",
                  "enum": [
                    "enemy",
                    "neutral"
                  ]
                }
              }
            }
          },
          "surprise": {
            "type": "string",
            "enum": [
              "",
              "party",
              "enemies"
            ]
          },
          "flag": {
            "type": "string"
          },
          "text": {
            "type": "string"
          }
        }
      }
    },
    "narration": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "cell": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "integer",
        "minimum": 0
      }
    }
  }
}
