{
  "$id": "strahd_attention.schema.json",
  "title": "Strahd's attention (F9; story/strahd_presence.gd)",
  "type": "object",
  "required": [
    "id",
    "summary",
    "tiers",
    "marks"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "const": "attention"
    },
    "summary": {
      "type": "string"
    },
    "tiers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "min"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "min": {
            "type": "integer",
            "minimum": 0
          },
          "gap": {
            "type": "number",
            "minimum": 0.1,
            "maximum": 1
          },
          "road_day": {
            "type": "number",
            "minimum": 0,
            "maximum": 0.5
          },
          "road_night": {
            "type": "number",
            "minimum": 0,
            "maximum": 0.5
          },
          "summary": {
            "type": "string"
          }
        }
      }
    },
    "marks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "when",
          "points",
          "summary"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "when": {
            "type": "string"
          },
          "points": {
            "type": "integer"
          },
          "summary": {
            "type": "string"
          }
        }
      }
    }
  }
}
