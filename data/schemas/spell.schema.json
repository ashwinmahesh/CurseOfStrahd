{
  "$id": "spell.schema.json",
  "title": "Spell",
  "type": "object",
  "required": ["id", "name", "source", "level", "school", "classes", "casting_time", "range", "components", "duration", "summary"],
  "additionalProperties": false,
  "properties": {
    "id": {"$ref": "common.schema.json#/$defs/id"},
    "name": {"type": "string"},
    "source": {"$ref": "common.schema.json#/$defs/source"},
    "level": {"type": "integer", "minimum": 0, "maximum": 9},
    "school": {"type": "string", "enum": ["abjuration", "conjuration", "divination", "enchantment", "evocation", "illusion", "necromancy", "transmutation"]},
    "classes": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/id"}},
    "casting_time": {"type": "object", "required": ["unit"], "properties": {"unit": {"type": "string", "enum": ["action", "bonus_action", "reaction", "minute", "hour"]}, "amount": {"type": "integer"}, "trigger": {"type": "string"}}},
    "ritual": {"type": "boolean"},
    "range": {"type": "object", "required": ["kind"], "properties": {"kind": {"type": "string", "enum": ["self", "touch", "feet", "sight", "unlimited", "special"]}, "feet": {"type": "integer"}}},
    "area": {"type": "object", "properties": {"shape": {"type": "string", "enum": ["cone", "cube", "cylinder", "emanation", "line", "sphere"]}, "size": {"type": "integer"}, "width": {"type": "integer"}}},
    "components": {"type": "object", "properties": {"v": {"type": "boolean"}, "s": {"type": "boolean"}, "m": {"type": "string"}, "m_cost_gp": {"type": "number"}, "m_consumed": {"type": "boolean"}}},
    "duration": {"type": "object", "required": ["kind"], "properties": {"kind": {"type": "string", "enum": ["instantaneous", "rounds", "minutes", "hours", "days", "until_dispelled", "special"]}, "amount": {"type": "integer"}, "concentration": {"type": "boolean"}}},
    "attack": {"type": "string", "enum": ["melee", "ranged"]},
    "save": {"$ref": "common.schema.json#/$defs/ability"},
    "damage": {"type": "array", "items": {"type": "object", "required": ["dice", "type"], "properties": {"dice": {"$ref": "common.schema.json#/$defs/dice"}, "type": {"$ref": "common.schema.json#/$defs/damage_type"}}}},
    "upcast": {"type": "object"},
    "cantrip_scaling": {"type": "object"},
    "summary": {"type": "string"},
    "text": {"type": "string"},
    "effects": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/effect_ref"}}
  }
}
