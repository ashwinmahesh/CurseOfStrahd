{
  "$id": "spell.schema.json",
  "title": "Spell",
  "type": "object",
  "required": ["id", "name", "source", "level", "school", "classes", "casting_time", "range", "components", "duration", "summary", "text"],
  "additionalProperties": false,
  "properties": {
    "id": {"$ref": "common.schema.json#/$defs/id"},
    "name": {"type": "string"},
    "source": {"$ref": "common.schema.json#/$defs/source"},
    "level": {"type": "integer", "minimum": 0, "maximum": 9},
    "school": {"type": "string", "enum": ["abjuration", "conjuration", "divination", "enchantment", "evocation", "illusion", "necromancy", "transmutation"]},
    "classes": {"type": "array", "minItems": 1, "items": {"type": "string", "enum": ["bard", "cleric", "druid", "paladin", "ranger", "sorcerer", "warlock", "wizard"]}},
    "casting_time": {
      "type": "object",
      "required": ["unit"],
      "additionalProperties": false,
      "properties": {
        "unit": {"type": "string", "enum": ["action", "bonus_action", "reaction", "minute", "hour"]},
        "amount": {"type": "integer", "minimum": 1},
        "trigger": {"type": "string", "description": "Reaction trigger in our own words."}
      }
    },
    "ritual": {"type": "boolean"},
    "range": {
      "type": "object",
      "required": ["kind"],
      "additionalProperties": false,
      "properties": {
        "kind": {"type": "string", "enum": ["self", "touch", "feet", "miles", "sight", "unlimited", "special"]},
        "feet": {"type": "integer", "minimum": 0},
        "miles": {"type": "integer", "minimum": 0}
      }
    },
    "area": {
      "type": "object",
      "required": ["shape", "size"],
      "additionalProperties": false,
      "properties": {
        "shape": {"type": "string", "enum": ["cone", "cube", "cylinder", "emanation", "line", "sphere", "wall"]},
        "size": {"type": "integer", "minimum": 0, "description": "Feet: cone length, cube side, cylinder/sphere/emanation radius, line length, wall length."},
        "width": {"type": "integer"},
        "height": {"type": "integer"}
      }
    },
    "components": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "v": {"type": "boolean"},
        "s": {"type": "boolean"},
        "m": {"type": "string", "description": "Material component, plainly described."},
        "m_cost_gp": {"type": "number", "minimum": 0},
        "m_consumed": {"type": "boolean"}
      }
    },
    "duration": {
      "type": "object",
      "required": ["kind"],
      "additionalProperties": false,
      "properties": {
        "kind": {"type": "string", "enum": ["instantaneous", "rounds", "minutes", "hours", "days", "until_dispelled", "special"]},
        "amount": {"type": "integer", "minimum": 1},
        "concentration": {"type": "boolean"},
        "until_triggered": {"type": "boolean"}
      }
    },
    "targets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {"type": "string", "enum": ["self", "creature", "ally", "enemy", "object", "point", "area", "creature_or_object"]},
        "count": {"type": "integer", "minimum": 1},
        "description": {"type": "string"}
      }
    },
    "attack": {"type": "string", "enum": ["melee", "ranged"]},
    "save": {"$ref": "common.schema.json#/$defs/ability"},
    "save_success": {"type": "string", "enum": ["half", "none", "special"], "description": "What a successful save does to the damage or effect."},
    "damage": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["dice"],
        "additionalProperties": false,
        "properties": {
          "dice": {"$ref": "common.schema.json#/$defs/dice"},
          "type": {"$ref": "common.schema.json#/$defs/damage_type"},
          "type_choice": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/damage_type"}},
          "add_mod": {"type": "boolean", "description": "Add the spellcasting ability modifier."},
          "per": {"type": "string", "description": "When the dice are per missile/ray/beam/turn, e.g. dart, ray, turn."}
        }
      }
    },
    "heal": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dice": {"$ref": "common.schema.json#/$defs/dice"},
        "add_mod": {"type": "boolean"},
        "flat": {"type": "integer"}
      }
    },
    "temp_hp": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dice": {"$ref": "common.schema.json#/$defs/dice"},
        "add_mod": {"type": "boolean"},
        "flat": {"type": "integer"}
      }
    },
    "conditions": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/condition"}, "description": "Conditions a failed save or a hit imposes."},
    "upcast": {
      "type": "object",
      "additionalProperties": false,
      "description": "Per slot level above the spell's level.",
      "properties": {
        "damage": {"$ref": "common.schema.json#/$defs/dice"},
        "heal": {"$ref": "common.schema.json#/$defs/dice"},
        "temp_hp": {"type": "integer"},
        "targets": {"type": "integer"},
        "projectiles": {"type": "integer"},
        "text": {"type": "string"}
      }
    },
    "cantrip_scaling": {
      "type": "object",
      "additionalProperties": false,
      "description": "Cantrip upgrades at character levels 5, 11 and 17.",
      "properties": {
        "damage": {"$ref": "common.schema.json#/$defs/dice", "description": "Dice added at each of levels 5, 11 and 17."},
        "beams": {"type": "boolean", "description": "The upgrade adds beams/projectiles rather than dice."},
        "text": {"type": "string"}
      }
    },
    "effects": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/effect_ref"}},
    "tags": {"type": "array", "items": {"type": "string", "enum": ["damage", "healing", "buff", "debuff", "control", "defense", "utility", "detection", "movement", "communication", "summon", "social", "light", "restoration"]}},
    "summary": {"type": "string", "minLength": 1},
    "text": {"type": "string", "minLength": 1, "description": "The complete rule in our own words: every number and condition a player needs, never copied text."}
  }
}
