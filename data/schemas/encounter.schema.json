{
  "$id": "encounter.schema.json",
  "title": "Combat encounter (plan §5.3, ADR 0007): a grid map as rows of characters plus who starts where",
  "type": "object",
  "required": [
    "id",
    "name",
    "summary",
    "party_level",
    "map",
    "party",
    "enemies"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "name": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "text": {
      "type": "string",
      "description": "Scene-setting read when the fight starts (our own words)."
    },
    "party_level": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20
    },
    "difficulty": {
      "type": "string",
      "enum": [
        "low",
        "moderate",
        "high"
      ],
      "description": "2024 DMG XP budget band for the party (checked by the validator)."
    },
    "map": {
      "type": "object",
      "required": [
        "rows"
      ],
      "additionalProperties": false,
      "properties": {
        "rows": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[.#=~w 1-4]+$"
          },
          "description": "'.' floor, '#' wall, '=' low cover (blocks movement, Half Cover), '~' Difficult Terrain, ' ' void, '1'-'4' floor raised 5 ft per step."
        },
        "ceiling_ft": {
          "type": "integer",
          "minimum": 10,
          "description": "The ceiling's height in feet, which flyers can't rise above. Default: 20 indoors, the open sky outdoors."
        },
        "drop_ft": {
          "type": "integer",
          "minimum": 10,
          "description": "How far the open void beside the floor falls (a chasm, a tower's well): a creature forced over the edge falls this far and out of the fight. Without it, the void is the map's edge and nothing crosses it."
        },
        "theme": {
          "type": "string",
          "description": "Which look the 3D scene dresses the map in."
        },
        "light": {
          "type": "string",
          "enum": [
            "bright",
            "dim",
            "dark"
          ]
        }
      }
    },
    "party": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "pregen",
          "cell"
        ],
        "additionalProperties": false,
        "properties": {
          "pregen": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "cell": {
            "$ref": "#/$defs/cell"
          },
          "precast": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/id"
            },
            "description": "Long-lasting spells cast before the fight (Mage Armor), paid for with slots."
          }
        }
      }
    },
    "enemies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "monster",
          "cell"
        ],
        "additionalProperties": false,
        "properties": {
          "monster": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "cell": {
            "$ref": "#/$defs/cell"
          },
          "name": {
            "type": "string"
          },
          "side": {
            "type": "string",
            "enum": [
              "enemy",
              "neutral"
            ]
          }
        }
      }
    },
    "surprised": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "party",
          "enemies"
        ]
      }
    }
  },
  "$defs": {
    "cell": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "integer",
        "minimum": 0
      },
      "description": "[x, z] of the creature's top-left square."
    }
  }
}
