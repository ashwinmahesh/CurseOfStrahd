{
  "id": "zarovich_hills",
  "map": "lake_zarovich_trail",
  "chance_day": 0.2,
  "chance_night": 0.45,
  "summary": "The trails through the hills between Vallaki, Lake Zarovich, the werewolves' den and Lake Baratok: pines, boulders and long views. Kiril's wolves by day and night until the pack question is settled; the hungry dead by night.",
  "entries": [
    {
      "id": "pack_hunt",
      "weight": 3,
      "when": "night and flag.wolf_pack_leader != \"emil\" and flag.wolf_pack_leader != \"none\"",
      "monsters": [
        {
          "monster": "werewolf",
          "cell": [
            22,
            5
          ]
        },
        {
          "monster": "werewolf",
          "cell": [
            25,
            9
          ]
        },
        {
          "monster": "werewolf",
          "cell": [
            24,
            13
          ]
        },
        {
          "monster": "wolf",
          "cell": [
            19,
            6
          ]
        },
        {
          "monster": "wolf",
          "cell": [
            20,
            12
          ]
        },
        {
          "monster": "wolf",
          "cell": [
            27,
            11
          ]
        }
      ],
      "text": "A howl goes up close by, then another, and then grey shapes are pouring through the pines on both sides of the trail. Kiril's wolves are hunting, and tonight they've found something better than deer."
    },
    {
      "id": "dire_wolves",
      "weight": 2,
      "when": "day and flag.wolf_pack_leader != \"emil\"",
      "monsters": [
        {
          "monster": "werewolf",
          "cell": [
            25,
            10
          ],
          "name": "Pack leader"
        },
        {
          "monster": "dire_wolf",
          "cell": [
            23,
            4
          ]
        },
        {
          "monster": "dire_wolf",
          "cell": [
            26,
            7
          ]
        },
        {
          "monster": "dire_wolf",
          "cell": [
            21,
            14
          ]
        },
        {
          "monster": "dire_wolf",
          "cell": [
            28,
            13
          ]
        },
        {
          "monster": "dire_wolf",
          "cell": [
            17,
            12
          ]
        }
      ],
      "text": "Dire wolves, five of them, big as ponies, fanning out across the slope ahead. Behind them a man steps out from the trees, smiling, and starts to change."
    },
    {
      "id": "hill_ghouls",
      "weight": 2,
