      }
    },
    {
      "id": "school_mastery_minor",
      "name": "Minor Mastery",
      "summary": "A level 1 spell of that school from your class spell lists is always prepared, cast without a slot or components.",
      "text": "Pick a level 1 spell of that school from a class spell list you can cast from. It's always prepared, and you can cast it without a spell slot or any components; you can still cast it with a slot to cast it higher.",
      "implemented": "engine",
      "choice": {
        "id": "minor_spell",
        "kind": "spell",
        "count": 1,
        "filter": {
          "level": 1,
          "school": "@school",
          "own_lists": true
        }
      },
      "modifiers": [
        {
          "stat": "spell",
          "value": "@minor_spell",
          "ability": "@increased",
          "always_prepared": true,
          "at_will": true
        }
      ]
    },
    {
      "id": "school_mastery_major",
      "name": "Major Mastery",
      "summary": "A spell of that school of level 1 to 7 from your class spell lists is always prepared, with one free casting per Long Rest.",
      "text": "Pick a spell of that school of level 7 or lower from a class spell list you can cast from. It's always prepared, and you can cast it once without a spell slot, regaining that casting when you finish a Long Rest; otherwise you cast it with slots as usual.",
      "implemented": "data",
      "choice": {
        "id": "major_spell",
        "kind": "spell",
        "count": 1,
        "filter": {
          "min_level": 1,
          "max_level": 7,
          "school": "@school",
          "own_lists": true
        }
      },
      "modifiers": [
        {
          "stat": "spell",
          "value": "@major_spell",
          "ability": "@increased",
          "always_prepared": true,
          "uses": {
            "count": 1,
            "recharge": "long"
          }
        }
      ]
    }
  ],
