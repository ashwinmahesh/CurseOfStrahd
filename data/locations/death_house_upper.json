    {
      "id": "strahd_letter",
      "cell": [
        4,
        11
      ],
      "kind": "book",
      "label": "a letter signed S",
      "model": "letter",
      "codex": "death_house_strahd_letter",
      "dialogue": "death_house/house:strahd_letter",
      "text": "Gustav. Your devotion has been noted, and declined. You mistake me for a god who answers prayers; I am a lord who collects what he is owed. Your circle of candles and borrowed incantations will not buy you a single extra year, let alone eternity. Should it ever amuse me, I may come to dinner. Do not set a place. S."
    },
